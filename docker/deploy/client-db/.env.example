# On the client server. Copy to .env.
DB_ROOT_PASSWORD=change-me-to-a-long-random-password
# VPN / private IP of THIS server to listen on (not a public IP)
BIND_ADDRESS=10.0.0.2
DB_PORT=3306
# Firewall example (allow only our app server, here 10.0.0.1):
#   ufw allow from 10.0.0.1 to any port 3306 proto tcp
