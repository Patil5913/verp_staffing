{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-04-28 15:17:18.125076",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!-- ============================================================\n     ERPNext \u2014 Sales Auditing Voucher Print Format\n     Theme    : Minimal White + Teal Accent (ref-matched)\n     Doctype  : Sales Auditing Voucher (custom)\n     ============================================================ -->\n\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody, .print-format {\n  font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;\n  font-size: 12px;\n  color: #222;\n  background: #fff;\n  line-height: 1.5;\n}\n\n.sav-wrap {\n  width: 100%;\n  max-width: 900px;\n  margin: 0 auto;\n  background: #fff;\n}\n\n/* \u2500\u2500 HEADER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-header {\n  width: 100%;\n  border-collapse: collapse;\n  border-bottom: 3px solid #17a6b0;\n}\n\n.sav-header-company {\n  padding: 22px 20px 18px 0;\n  vertical-align: top;\n  width: 55%;\n}\n\n.sav-header-title {\n  padding: 22px 0 18px 20px;\n  vertical-align: top;\n  text-align: right;\n  width: 45%;\n}\n\n.sav-co-name {\n  font-size: 18px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 4px;\n}\n\n.sav-co-meta {\n  font-size: 10.5px;\n  color: #666;\n  line-height: 1.75;\n}\n\n.sav-doc-eyebrow {\n  font-size: 8.5px;\n  font-weight: 700;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  color: #999;\n  margin-bottom: 4px;\n}\n\n.sav-doc-title {\n  font-size: 20px;\n  font-weight: 800;\n  color: #111;\n  line-height: 1.15;\n  margin-bottom: 10px;\n}\n\n.sav-doc-number {\n  font-size: 11px;\n  color: #666;\n  margin-bottom: 3px;\n}\n\n.sav-doc-number strong { color: #111; font-size: 12px; }\n\n/* Status badge */\n.sav-status-badge {\n  display: inline-block;\n  margin-top: 8px;\n  padding: 3px 12px;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.8px;\n  text-transform: uppercase;\n  border-radius: 3px;\n}\n\n.badge-draft     { background: #f2f2f2; color: #888; border: 1px solid #ddd; }\n.badge-submitted { background: #e6f7f8; color: #17a6b0; border: 1px solid #b2e0e4; }\n.badge-approved  { background: #111; color: #fff; border: 1px solid #111; }\n.badge-rejected  { background: #fff5f5; color: #c0392b; border: 1px solid #f5c6c0; }\n\n/* \u2500\u2500 INFO STRIP \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-strip {\n  width: 100%;\n  border-collapse: collapse;\n  background: #f7feff;\n  border-top: 1px solid #c8eef1;\n  border-bottom: 1px solid #c8eef1;\n}\n\n.sav-strip td {\n  padding: 6px 14px;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  color: #888;\n  white-space: nowrap;\n}\n\n.sav-strip td span {\n  font-weight: 600;\n  text-transform: none;\n  margin-left: 4px;\n  letter-spacing: 0;\n  color: #222;\n}\n\n.sav-strip-div {\n  color: #c8eef1 !important;\n  padding: 6px 2px !important;\n  font-size: 13px !important;\n  font-weight: 300 !important;\n}\n\n/* \u2500\u2500 CONTEXT BAND \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-context {\n  width: 100%;\n  border-collapse: collapse;\n  border-bottom: 1px solid #e8e8e8;\n}\n\n.sav-context > tbody > tr > td {\n  padding: 14px 16px;\n  vertical-align: top;\n  border-right: 1px solid #f0f0f0;\n}\n\n.sav-context > tbody > tr > td:last-child { border-right: none; }\n\n.sav-ctx-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.2px;\n  color: #17a6b0;\n  margin-bottom: 5px;\n  padding-bottom: 4px;\n  border-bottom: 1.5px solid #e8e8e8;\n}\n\n.sav-ctx-primary {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 3px;\n}\n\n.sav-ctx-secondary {\n  font-size: 10.5px;\n  color: #666;\n  line-height: 1.65;\n}\n\n/* \u2500\u2500 SECTION TITLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-section-wrap { width: 100%; border-collapse: collapse; }\n.sav-section-wrap > tbody > tr > td { padding: 18px 0 0; }\n\n.sav-section-title {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n  color: #17a6b0;\n  display: block;\n  padding: 6px 0 6px 0;\n  border-bottom: 1.5px solid #17a6b0;\n  margin-bottom: 0;\n}\n\n/* \u2500\u2500 LEDGER TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-ledger-wrap { width: 100%; border-collapse: collapse; }\n.sav-ledger-wrap > tbody > tr > td { padding: 0; }\n\n.sav-ledger {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n}\n\n.sav-ledger thead tr.sav-col-group th {\n  background: #f7feff;\n  color: #444;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  padding: 8px 7px;\n  text-align: left;\n  border-top: 2px solid #17a6b0;\n  border-bottom: 1px solid #ddd;\n  border-right: 1px solid #eee;\n  white-space: nowrap;\n}\n\n.sav-ledger thead tr.sav-col-group th:last-child { border-right: none; }\n.sav-ledger thead tr.sav-col-group th.r { text-align: right; }\n.sav-ledger thead tr.sav-col-group th.c { text-align: center; }\n\n.sav-ledger thead tr.sav-col-sub th {\n  background: #fff;\n  color: #aaa;\n  font-size: 8.5px;\n  font-weight: 600;\n  padding: 3px 7px;\n  text-align: right;\n  border-bottom: 1px solid #eee;\n  border-right: 1px solid #f2f2f2;\n}\n\n.sav-ledger thead tr.sav-col-sub th:last-child { border-right: none; }\n.sav-ledger thead tr.sav-col-sub th.l { text-align: left; }\n\n.sav-ledger tbody tr { border-bottom: 1px solid #f2f2f2; }\n.sav-ledger tbody tr:nth-child(even) { background: #fafeff; }\n\n.sav-ledger tbody td {\n  padding: 8px 7px;\n  font-size: 11px;\n  color: #333;\n  vertical-align: middle;\n  border-right: 1px solid #f2f2f2;\n  word-break: break-word;\n}\n\n.sav-ledger tbody td:last-child { border-right: none; }\n.sav-ledger tbody td.r { text-align: right; font-variant-numeric: tabular-nums; }\n.sav-ledger tbody td.c { text-align: center; }\n\n.sav-sno {\n  display: inline-block;\n  min-width: 20px;\n  height: 20px;\n  line-height: 20px;\n  text-align: center;\n  background: #f0f0f0;\n  font-size: 10px;\n  font-weight: 700;\n  color: #777;\n  padding: 0 3px;\n  border-radius: 2px;\n}\n\n/* Voucher type tag \u2014 teal tint */\n.sav-vtype {\n  display: inline-block;\n  padding: 2px 6px;\n  font-size: 9px;\n  font-weight: 700;\n  border-radius: 3px;\n  white-space: nowrap;\n  background: #e6f7f8;\n  color: #17a6b0;\n  border: 1px solid #b2e0e4;\n}\n\n.sav-debit  { color: #17a6b0; font-weight: 600; }\n.sav-credit { color: #2a9d5c; font-weight: 600; }\n.sav-bal    { color: #111; font-weight: 700; }\n.sav-neg    { color: #c0392b; font-weight: 700; }\n\n.sav-empty-row td {\n  text-align: center;\n  padding: 24px !important;\n  color: #aaa;\n  font-style: italic;\n}\n\n/* tfoot */\n.sav-ledger tfoot tr.sav-subtotal td {\n  padding: 7px 7px;\n  font-size: 11px;\n  font-weight: 700;\n  background: #f7feff;\n  border-top: 1.5px solid #17a6b0;\n  border-bottom: 1px solid #ddd;\n  color: #333;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.sav-ledger tfoot tr.sav-subtotal td.r { text-align: right; }\n\n.sav-ledger tfoot tr.sav-grandtotal td {\n  padding: 9px 7px;\n  font-size: 12px;\n  font-weight: 800;\n  background: #17a6b0;\n  color: #fff;\n}\n\n.sav-ledger tfoot tr.sav-grandtotal td.r { text-align: right; color: #fff; font-size: 13px; }\n\n/* \u2500\u2500 SUMMARY CARDS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-summary-wrap { width: 100%; border-collapse: collapse; }\n.sav-summary-wrap > tbody > tr > td { padding: 10px 0 0; }\n\n.sav-summary-cards { width: 100%; border-collapse: collapse; }\n.sav-summary-cards > tbody > tr > td { width: 20%; vertical-align: top; padding: 0 8px 0 0; }\n.sav-summary-cards > tbody > tr > td:last-child { padding-right: 0; }\n\n.sav-card {\n  border: 1px solid #e8e8e8;\n  border-top: 2.5px solid #17a6b0;\n  padding: 10px 12px;\n  background: #fff;\n}\n\n.sav-card-label {\n  font-size: 8px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.8px;\n  color: #999;\n  margin-bottom: 5px;\n}\n\n.sav-card-value {\n  font-size: 13px;\n  font-weight: 800;\n  color: #111;\n  font-variant-numeric: tabular-nums;\n  line-height: 1.2;\n  word-break: break-all;\n}\n\n.sav-card-sub { font-size: 9px; color: #aaa; margin-top: 3px; }\n\n/* \u2500\u2500 LOWER SECTION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-lower-wrap { width: 100%; border-collapse: collapse; }\n.sav-lower-wrap > tbody > tr > td { padding: 14px 0 0; vertical-align: top; width: 50%; }\n.sav-lower-wrap > tbody > tr > td + td { padding-left: 20px; border-left: 1px solid #f0f0f0; }\n\n.sav-box {\n  border: 1px solid #e8e8e8;\n  border-top: 2px solid #17a6b0;\n  padding: 12px 14px;\n  background: #fff;\n}\n\n.sav-box-title {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.2px;\n  color: #17a6b0;\n  padding-bottom: 6px;\n  border-bottom: 1px solid #e8e8e8;\n  margin-bottom: 10px;\n}\n\n.sav-box-body { font-size: 11px; color: #444; line-height: 1.7; }\n\n/* Checklist */\n.sav-checklist { width: 100%; border-collapse: collapse; }\n\n.sav-checklist tr td {\n  padding: 5px 0;\n  font-size: 11px;\n  border-bottom: 1px solid #f5f5f5;\n  color: #555;\n}\n\n.sav-checklist tr:last-child td { border-bottom: none; }\n\n.sav-check-ok   { color: #17a6b0; font-weight: 700; }\n.sav-check-warn { color: #e6a817; font-weight: 700; }\n.sav-check-err  { color: #c0392b; font-weight: 700; }\n.sav-check-na   { color: #bbb; font-weight: 500; }\n\n/* \u2500\u2500 VARIANCE TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-variance-wrap { width: 100%; border-collapse: collapse; }\n.sav-variance-wrap > tbody > tr > td { padding: 10px 0 0; }\n\n.sav-variance-table {\n  width: 100%;\n  border-collapse: collapse;\n  border: 1px solid #e8e8e8;\n}\n\n.sav-variance-table thead th {\n  background: #f7feff;\n  color: #555;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  padding: 7px 10px;\n  text-align: left;\n  border-bottom: 1px solid #ddd;\n  border-right: 1px solid #eee;\n}\n\n.sav-variance-table thead th:last-child { border-right: none; }\n.sav-variance-table thead th.r { text-align: right; }\n\n.sav-variance-table tbody td {\n  padding: 7px 10px;\n  font-size: 11px;\n  color: #333;\n  border-bottom: 1px solid #f2f2f2;\n  border-right: 1px solid #f2f2f2;\n}\n\n.sav-variance-table tbody td:last-child { border-right: none; }\n.sav-variance-table tbody tr:last-child td { border-bottom: none; }\n.sav-variance-table tbody td.r { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }\n\n.status-ok   { display:inline-block; font-size:9px; font-weight:700; padding:2px 8px; background:#e6f7f8; color:#17a6b0; border:1px solid #b2e0e4; border-radius:3px; }\n.status-warn { display:inline-block; font-size:9px; font-weight:700; padding:2px 8px; background:#fff9e6; color:#b07d00; border:1px solid #f5dfa0; border-radius:3px; }\n.status-info { display:inline-block; font-size:9px; font-weight:700; padding:2px 8px; background:#f2f2f2; color:#888; border:1px solid #ddd; border-radius:3px; }\n\n/* \u2500\u2500 APPROVAL BLOCK \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-approval-wrap { width: 100%; border-collapse: collapse; }\n.sav-approval-wrap > tbody > tr > td { padding: 14px 0 0; }\n\n.sav-approval-table {\n  width: 100%;\n  border-collapse: collapse;\n  border: 1px solid #e8e8e8;\n}\n\n.sav-approval-table > tbody > tr > td {\n  width: 33.33%;\n  padding: 14px 16px 22px;\n  vertical-align: bottom;\n  text-align: center;\n  border-right: 1px solid #f0f0f0;\n}\n\n.sav-approval-table > tbody > tr > td:last-child { border-right: none; }\n\n.sav-appr-role {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: #17a6b0;\n  margin-bottom: 26px;\n  padding-bottom: 5px;\n  border-bottom: 1px solid #e8e8e8;\n}\n\n.sav-stamp-circle {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  border: 1.5px dashed #c8eef1;\n  margin: 0 auto 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #bbb;\n  font-size: 8px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  line-height: 1.3;\n  text-align: center;\n}\n\n.sav-sig-area {\n  height: 32px;\n  border-bottom: 1.5px solid #17a6b0;\n  margin: 0 auto 8px;\n  width: 78%;\n}\n\n.sav-appr-name { font-size: 11.5px; font-weight: 700; color: #111; margin-bottom: 2px; }\n.sav-appr-label { font-size: 9px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; }\n.sav-appr-date { font-size: 9px; color: #aaa; margin-top: 3px; }\n\n/* \u2500\u2500 CERTIFICATION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-cert-wrap { width: 100%; border-collapse: collapse; }\n.sav-cert-wrap > tbody > tr > td { padding: 14px 0 0; }\n\n.sav-cert-box {\n  background: #f7feff;\n  border: 1px solid #c8eef1;\n  border-left: 3px solid #17a6b0;\n  padding: 10px 14px;\n}\n\n.sav-cert-text { font-size: 10.5px; color: #555; line-height: 1.7; }\n.sav-cert-text strong { color: #111; }\n\n/* \u2500\u2500 FOOTER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.sav-footer {\n  width: 100%;\n  border-collapse: collapse;\n  border-top: 2px solid #17a6b0;\n  margin-top: 24px;\n}\n\n.sav-footer td { padding: 10px 0; font-size: 9.5px; }\n\n.sav-footer-left  { color: #aaa; font-style: italic; white-space: nowrap; }\n.sav-footer-mid   { text-align: center; color: #bbb; font-size: 9px; }\n.sav-footer-right { text-align: right; color: #888; white-space: nowrap; }\n.sav-footer-right strong { color: #17a6b0; }\n\n/* \u2500\u2500 UTILITY \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.muted { color: #aaa; }\n.fw7   { font-weight: 700; }\n.fw8   { font-weight: 800; }\n.ta-r  { text-align: right; }\n.ta-c  { text-align: center; }\n\n@media print {\n  body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n  .sav-wrap { max-width: 100%; }\n}\n</style>\n\n<div class=\"sav-wrap\">\n\n<!-- 1. HEADER -->\n<table class=\"sav-header\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td class=\"sav-header-company\">\n        {% if doc.get('company_logo') %}\n          <img src=\"{{ doc.company_logo }}\" alt=\"{{ doc.company }}\"\n               style=\"max-height:40px; margin-bottom:8px; display:block;\">\n        {% endif %}\n        <div class=\"sav-co-name\">{{ doc.company }}</div>\n        <div class=\"sav-co-meta\">\n          {% if doc.get('company_address') %}{{ doc.company_address | replace('\\n', '<br>') }}<br>{% endif %}\n          {% if doc.get('company_gstin') %}GSTIN: {{ doc.company_gstin }}{% endif %}\n          {% if doc.get('company_pan') %}&nbsp;&nbsp;|&nbsp;&nbsp;PAN: {{ doc.company_pan }}{% endif %}\n        </div>\n      </td>\n      <td class=\"sav-header-title\">\n        <div class=\"sav-doc-eyebrow\">Internal Document</div>\n        <div class=\"sav-doc-title\">Sales Auditing Voucher</div>\n        <div class=\"sav-doc-number\">Voucher No.&nbsp;<strong>{{ doc.name }}</strong></div>\n        <div class=\"sav-doc-number\" style=\"margin-top:2px;\">Date:&nbsp;<strong>{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</strong></div>\n        {%- set status_val = doc.get('status') or 'Draft' -%}\n        {%- if status_val == 'Submitted' -%}\n          <span class=\"sav-status-badge badge-submitted\">&#10003;&nbsp;Submitted</span>\n        {%- elif status_val == 'Approved' -%}\n          <span class=\"sav-status-badge badge-approved\">&#10003;&nbsp;Approved</span>\n        {%- elif status_val == 'Rejected' -%}\n          <span class=\"sav-status-badge badge-rejected\">&#10007;&nbsp;Rejected</span>\n        {%- else -%}\n          <span class=\"sav-status-badge badge-draft\">&#9679;&nbsp;Draft</span>\n        {%- endif -%}\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 2. INFO STRIP -->\n<table class=\"sav-strip\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td>Audit Period <span>{{ frappe.format(doc.get('from_date') or doc.posting_date, {'fieldtype': 'Date'}) }} \u2014 {{ frappe.format(doc.get('to_date') or doc.posting_date, {'fieldtype': 'Date'}) }}</span></td>\n      <td class=\"sav-strip-div\">|</td>\n      <td>Auditor <span>{{ doc.get('auditor') or '\u2014' }}</span></td>\n      <td class=\"sav-strip-div\">|</td>\n      <td>Dept <span>{{ doc.get('department') or '\u2014' }}</span></td>\n      <td class=\"sav-strip-div\">|</td>\n      <td>Currency <span>{{ doc.currency }}</span></td>\n      <td class=\"sav-strip-div\">|</td>\n      <td>Date <span>{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</span></td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 3. CONTEXT BAND -->\n<table class=\"sav-context\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"width:28%;\">\n        <div class=\"sav-ctx-label\">Customer / Party</div>\n        <div class=\"sav-ctx-primary\">{{ doc.get('customer') or '\u2014' }}</div>\n        <div class=\"sav-ctx-secondary\">\n          {% if doc.get('customer_group') %}Group: {{ doc.customer_group }}<br>{% endif %}\n          {% if doc.get('territory') %}Territory: {{ doc.territory }}{% endif %}\n        </div>\n      </td>\n      <td style=\"width:26%;\">\n        <div class=\"sav-ctx-label\">Audit Scope</div>\n        <div class=\"sav-ctx-primary\">{{ doc.get('audit_period') or 'Sales Ledger Audit' }}</div>\n        <div class=\"sav-ctx-secondary\">\n          {% if doc.get('from_date') and doc.get('to_date') %}\n            {{ frappe.format(doc.from_date, {'fieldtype': 'Date'}) }} to {{ frappe.format(doc.to_date, {'fieldtype': 'Date'}) }}<br>\n          {% endif %}\n          {% if doc.get('cost_center') %}Cost Centre: {{ doc.cost_center }}{% endif %}\n        </div>\n      </td>\n      <td style=\"width:24%;\">\n        <div class=\"sav-ctx-label\">Reference</div>\n        <div class=\"sav-ctx-secondary\" style=\"line-height:1.9;\">\n          <span class=\"muted\">Voucher No:</span>&nbsp;<strong style=\"color:#111;\">{{ doc.name }}</strong><br>\n          <span class=\"muted\">Date:</span>&nbsp;{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}<br>\n          {% if doc.get('amended_from') %}<span class=\"muted\">Amended:</span>&nbsp;{{ doc.amended_from }}<br>{% endif %}\n          <span class=\"muted\">Status:</span>&nbsp;{% if doc.docstatus == 0 %}Saved{% elif doc.docstatus == 1 %}Submitted{% elif doc.docstatus == 2 %}Cancelled{% endif %}\n        </div>\n      </td>\n      <td style=\"width:22%; background:#f7feff;\">\n        <div class=\"sav-ctx-label\">Totals Preview</div>\n        <div style=\"line-height:1.9;\">\n          <div style=\"font-size:10px; color:#888;\">Total Sales</div>\n          <div style=\"font-size:13px; font-weight:800; color:#111;\">\n            {{ frappe.format(doc.get('total_sales_amount') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}\n          </div>\n          <div style=\"font-size:10px; color:#888; margin-top:4px;\">Net Balance</div>\n          <div style=\"font-size:12px; font-weight:700; color:#17a6b0;\">\n            {{ frappe.format(doc.get('net_balance') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}\n          </div>\n        </div>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 4. SECTION \u2014 Ledger Entries -->\n<table class=\"sav-section-wrap\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody><tr><td><span class=\"sav-section-title\">Audit Ledger Entries</span></td></tr></tbody>\n</table>\n\n<!-- 5. LEDGER TABLE -->\n<table class=\"sav-ledger-wrap\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:0;\">\n  <tbody>\n    <tr><td style=\"padding-top:0;\">\n      <table class=\"sav-ledger\" cellpadding=\"0\" cellspacing=\"0\">\n        <colgroup>\n          <col style=\"width:28px;\">\n          <col style=\"width:70px;\">\n          <col style=\"width:74px;\">\n          <col style=\"width:92px;\">\n          <col>\n          <col>\n          <col style=\"width:82px;\">\n          <col style=\"width:82px;\">\n          <col style=\"width:82px;\">\n          <col style=\"width:86px;\">\n        </colgroup>\n        <thead>\n          <tr class=\"sav-col-group\">\n            <th class=\"c\">#</th>\n            <th>Date</th>\n            <th>Type</th>\n            <th>Voucher / Ref</th>\n            <th>Party / Account</th>\n            <th>Narration</th>\n            <th class=\"r\">Sales Amt.</th>\n            <th class=\"r\">Debit (Dr)</th>\n            <th class=\"r\">Credit (Cr)</th>\n            <th class=\"r\">Balance</th>\n          </tr>\n          <tr class=\"sav-col-sub\">\n            <th colspan=\"6\" class=\"l\">{{ doc.currency }} \u2014 All amounts in base currency</th>\n            <th>{{ doc.currency }}</th>\n            <th>{{ doc.currency }}</th>\n            <th>{{ doc.currency }}</th>\n            <th>{{ doc.currency }}</th>\n          </tr>\n        </thead>\n        <tbody>\n          {% if doc.get('audit_entries') %}\n            {% for entry in doc.audit_entries %}\n            {%- set bal = entry.get('balance') or 0 -%}\n            <tr>\n              <td class=\"c\"><span class=\"sav-sno\">{{ loop.index }}</span></td>\n              <td style=\"font-size:10.5px;\">{{ frappe.format(entry.get('posting_date') or entry.get('date') or '', {'fieldtype': 'Date'}) }}</td>\n              <td><span class=\"sav-vtype\">{{ entry.get('voucher_type') or 'Other' }}</span></td>\n              <td style=\"font-size:10.5px; font-weight:600; color:#111;\">{{ entry.get('voucher_no') or entry.get('reference') or '\u2014' }}</td>\n              <td>\n                <div style=\"font-weight:600; color:#111; font-size:11px;\">{{ entry.get('party') or entry.get('customer') or '\u2014' }}</div>\n                {% if entry.get('account') %}<div style=\"font-size:9.5px; color:#999;\">{{ entry.account }}</div>{% endif %}\n              </td>\n              <td style=\"font-size:10.5px; color:#666;\">{{ entry.get('remarks') or entry.get('narration') or '\u2014' }}</td>\n              <td class=\"r\" style=\"font-size:11px; font-weight:600; color:#111;\">\n                {% if entry.get('sales_amount') %}{{ frappe.format(entry.sales_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}{% else %}<span class=\"muted\">\u2014</span>{% endif %}\n              </td>\n              <td class=\"r sav-debit\">\n                {% if entry.get('debit') and entry.debit != 0 %}{{ frappe.format(entry.debit, {'fieldtype': 'Currency', 'currency': doc.currency}) }}{% else %}<span class=\"muted\">\u2014</span>{% endif %}\n              </td>\n              <td class=\"r sav-credit\">\n                {% if entry.get('credit') and entry.credit != 0 %}{{ frappe.format(entry.credit, {'fieldtype': 'Currency', 'currency': doc.currency}) }}{% else %}<span class=\"muted\">\u2014</span>{% endif %}\n              </td>\n              <td class=\"r {% if bal < 0 %}sav-neg{% else %}sav-bal{% endif %}\">\n                {% if bal < 0 %}({{ frappe.format(bal * -1, {'fieldtype': 'Currency', 'currency': doc.currency}) }}){% else %}{{ frappe.format(bal, {'fieldtype': 'Currency', 'currency': doc.currency}) }}{% endif %}\n              </td>\n            </tr>\n            {% endfor %}\n          {% else %}\n            <tr class=\"sav-empty-row\"><td colspan=\"10\">No audit entries found for this voucher.</td></tr>\n          {% endif %}\n        </tbody>\n        <tfoot>\n          <tr class=\"sav-subtotal\">\n            <td colspan=\"6\" class=\"fw7\">Sub-Total</td>\n            <td class=\"r\">{{ frappe.format(doc.get('total_sales_amount') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r sav-debit\">{{ frappe.format(doc.get('total_debit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r sav-credit\">{{ frappe.format(doc.get('total_credit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r\">{{ frappe.format(doc.get('net_balance') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n          </tr>\n          <tr class=\"sav-grandtotal\">\n            <td colspan=\"6\" class=\"fw8\" style=\"letter-spacing:0.3px; text-transform:uppercase;\">\n              Grand Total &nbsp;<span style=\"font-size:9px; opacity:0.6; font-weight:400; text-transform:none;\">({{ doc.currency }})</span>\n            </td>\n            <td class=\"r fw8\">{{ frappe.format(doc.get('total_sales_amount') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r fw8\">{{ frappe.format(doc.get('total_debit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r fw8\">{{ frappe.format(doc.get('total_credit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r fw8\" style=\"font-size:13px;\">{{ frappe.format(doc.get('net_balance') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n          </tr>\n        </tfoot>\n      </table>\n    </td></tr>\n  </tbody>\n</table>\n\n<!-- 6. SECTION \u2014 Financial Summary -->\n<table class=\"sav-section-wrap\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:14px;\">\n  <tbody><tr><td><span class=\"sav-section-title\">Financial Summary</span></td></tr></tbody>\n</table>\n\n<table class=\"sav-summary-wrap\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr><td>\n      <table class=\"sav-summary-cards\" cellpadding=\"0\" cellspacing=\"0\">\n        <tbody>\n          <tr>\n            <td>\n              <div class=\"sav-card\">\n                <div class=\"sav-card-label\">Total Sales</div>\n                <div class=\"sav-card-value\">{{ frappe.format(doc.get('total_sales_amount') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n                <div class=\"sav-card-sub\">Gross invoiced value</div>\n              </div>\n            </td>\n            <td>\n              <div class=\"sav-card\">\n                <div class=\"sav-card-label\">Total Debit (Dr)</div>\n                <div class=\"sav-card-value\" style=\"color:#17a6b0;\">{{ frappe.format(doc.get('total_debit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n                <div class=\"sav-card-sub\">Receivable postings</div>\n              </div>\n            </td>\n            <td>\n              <div class=\"sav-card\">\n                <div class=\"sav-card-label\">Total Credit (Cr)</div>\n                <div class=\"sav-card-value\" style=\"color:#2a9d5c;\">{{ frappe.format(doc.get('total_credit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n                <div class=\"sav-card-sub\">Payments &amp; returns</div>\n              </div>\n            </td>\n            <td>\n              <div class=\"sav-card\">\n                <div class=\"sav-card-label\">Variance</div>\n                <div class=\"sav-card-value\">{{ frappe.format(doc.get('variance') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n                <div class=\"sav-card-sub\">Dr &minus; Cr difference</div>\n              </div>\n            </td>\n            <td style=\"padding-right:0;\">\n              <div class=\"sav-card\">\n                <div class=\"sav-card-label\">Net Balance</div>\n                <div class=\"sav-card-value\" style=\"color:#17a6b0;\">{{ frappe.format(doc.get('net_balance') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</div>\n                <div class=\"sav-card-sub\">Closing ledger balance</div>\n              </div>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </td></tr>\n  </tbody>\n</table>\n\n<!-- 7. SECTION \u2014 Variance Analysis -->\n<table class=\"sav-section-wrap\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:14px;\">\n  <tbody><tr><td><span class=\"sav-section-title\">Variance Analysis</span></td></tr></tbody>\n</table>\n\n<table class=\"sav-variance-wrap\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr><td>\n      <table class=\"sav-variance-table\" cellpadding=\"0\" cellspacing=\"0\">\n        <thead>\n          <tr>\n            <th style=\"width:4%;\">#</th>\n            <th style=\"width:32%;\">Particulars</th>\n            <th class=\"r\" style=\"width:20%;\">Expected Amount</th>\n            <th class=\"r\" style=\"width:20%;\">Actual Amount</th>\n            <th class=\"r\" style=\"width:14%;\">Variance</th>\n            <th style=\"width:10%; text-align:center;\">Status</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td class=\"muted\" style=\"text-align:center;\">1</td>\n            <td class=\"fw7\">Total Sales (Invoiced)</td>\n            <td class=\"r\">{{ frappe.format(doc.get('total_sales_amount') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r\">{{ frappe.format(doc.get('total_debit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r\">{{ frappe.format(doc.get('variance') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td style=\"text-align:center;\">\n              {% set var_val = doc.get('variance') or 0 %}\n              {% if var_val == 0 %}<span class=\"status-ok\">&#10003; Matched</span>\n              {% else %}<span class=\"status-warn\">&#9888; Review</span>{% endif %}\n            </td>\n          </tr>\n          <tr>\n            <td class=\"muted\" style=\"text-align:center;\">2</td>\n            <td class=\"fw7\">Debit vs Credit Balance</td>\n            <td class=\"r\">{{ frappe.format(doc.get('total_debit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r\">{{ frappe.format(doc.get('total_credit') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            {%- set dr_cr_diff = ((doc.get('total_debit') or 0) - (doc.get('total_credit') or 0)) -%}\n            <td class=\"r {% if dr_cr_diff != 0 %}sav-neg{% endif %}\">{{ frappe.format(dr_cr_diff, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td style=\"text-align:center;\">\n              {% if dr_cr_diff == 0 %}<span class=\"status-ok\">&#10003; Balanced</span>\n              {% else %}<span class=\"status-warn\">&#9888; Unbalanced</span>{% endif %}\n            </td>\n          </tr>\n          <tr>\n            <td class=\"muted\" style=\"text-align:center;\">3</td>\n            <td class=\"fw7\">Net Balance (Closing)</td>\n            <td class=\"r muted\">\u2014</td>\n            <td class=\"r sav-bal\">{{ frappe.format(doc.get('net_balance') or 0, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            <td class=\"r muted\">\u2014</td>\n            <td style=\"text-align:center;\"><span class=\"status-info\">Computed</span></td>\n          </tr>\n        </tbody>\n      </table>\n    </td></tr>\n  </tbody>\n</table>\n\n<!-- 8. SECTION \u2014 Audit Findings -->\n<table class=\"sav-section-wrap\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:14px;\">\n  <tbody><tr><td><span class=\"sav-section-title\">Audit Findings &amp; Remarks</span></td></tr></tbody>\n</table>\n\n<table class=\"sav-lower-wrap\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td>\n        <div class=\"sav-box\">\n          <div class=\"sav-box-title\">Audit Checklist</div>\n          <table class=\"sav-checklist\" cellpadding=\"0\" cellspacing=\"0\">\n            <tbody>\n              <tr>\n                <td>1. All sales invoices posted in the period</td>\n                <td class=\"ta-r sav-check-ok\">&#10003; Done</td>\n              </tr>\n              <tr>\n                <td>2. Debit &amp; Credit entries reconciled</td>\n                {%- set dr_cr_chk = ((doc.get('total_debit') or 0) - (doc.get('total_credit') or 0)) -%}\n                <td class=\"ta-r {% if dr_cr_chk == 0 %}sav-check-ok{% else %}sav-check-err{% endif %}\">\n                  {% if dr_cr_chk == 0 %}&#10003; Balanced{% else %}&#9888; Review{% endif %}\n                </td>\n              </tr>\n              <tr>\n                <td>3. Variance within acceptable limit</td>\n                {%- set var_chk = doc.get('variance') or 0 -%}\n                <td class=\"ta-r {% if var_chk == 0 %}sav-check-ok{% else %}sav-check-warn{% endif %}\">\n                  {% if var_chk == 0 %}&#10003; Nil{% else %}&#9888; Variance Exists{% endif %}\n                </td>\n              </tr>\n              <tr>\n                <td>4. Customer ledger verified</td>\n                <td class=\"ta-r sav-check-ok\">&#10003; Verified</td>\n              </tr>\n              <tr>\n                <td>5. Supporting documents attached</td>\n                <td class=\"ta-r sav-check-na\">\u2014 Pending</td>\n              </tr>\n              <tr>\n                <td>6. Approved by authorised signatory</td>\n                <td class=\"ta-r {% if doc.get('approved_by') %}sav-check-ok{% else %}sav-check-warn{% endif %}\">\n                  {% if doc.get('approved_by') %}&#10003; Signed{% else %}&#9679; Awaiting{% endif %}\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </td>\n      <td>\n        <div class=\"sav-box\" style=\"height:100%;\">\n          <div class=\"sav-box-title\">Auditor Findings &amp; Observations</div>\n          <div class=\"sav-box-body\">\n            {% if doc.get('audit_findings') %}{{ doc.audit_findings | striptags }}\n            {% else %}<span class=\"muted\" style=\"font-style:italic;\">No specific findings recorded for this audit period.</span>{% endif %}\n          </div>\n          {% if doc.get('audit_remarks') or doc.get('remarks') %}\n          <div style=\"margin-top:12px;\">\n            <div class=\"sav-box-title\">Additional Remarks</div>\n            <div class=\"sav-box-body\">{{ (doc.get('audit_remarks') or doc.get('remarks') or '') | striptags }}</div>\n          </div>\n          {% endif %}\n        </div>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 9. CERTIFICATION -->\n<table class=\"sav-cert-wrap\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:14px;\">\n  <tbody>\n    <tr><td>\n      <div class=\"sav-cert-box\">\n        <div class=\"sav-cert-text\">\n          <strong>Certification:</strong>&nbsp;\n          We hereby certify that the sales transactions audited in this voucher for the period\n          <strong>{{ frappe.format(doc.get('from_date') or doc.posting_date, {'fieldtype': 'Date'}) }} to {{ frappe.format(doc.get('to_date') or doc.posting_date, {'fieldtype': 'Date'}) }}</strong>\n          are in accordance with the books of accounts maintained by <strong>{{ doc.company }}</strong>,\n          and to the best of our knowledge, all entries are true, fair, and free from material misstatement.\n          This voucher is generated electronically via ERPNext and is valid without a wet signature unless otherwise specified.\n        </div>\n      </div>\n    </td></tr>\n  </tbody>\n</table>\n\n<!-- 10. SECTION \u2014 Authorisation -->\n<table class=\"sav-section-wrap\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:14px;\">\n  <tbody><tr><td><span class=\"sav-section-title\">Authorisation &amp; Sign-off</span></td></tr></tbody>\n</table>\n\n<table class=\"sav-approval-wrap\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr><td>\n      <table class=\"sav-approval-table\" cellpadding=\"0\" cellspacing=\"0\">\n        <tbody>\n          <tr>\n            <td>\n              <div class=\"sav-appr-role\">Prepared By</div>\n              <div class=\"sav-stamp-circle\">Stamp<br>Here</div>\n              <div class=\"sav-sig-area\"></div>\n              <div class=\"sav-appr-name\">{{ doc.get('prepared_by') or doc.get('owner') or '_______________' }}</div>\n              <div class=\"sav-appr-label\">Accounts / Audit Staff</div>\n              <div class=\"sav-appr-date\">Date: {{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</div>\n            </td>\n            <td>\n              <div class=\"sav-appr-role\">Verified By</div>\n              <div class=\"sav-stamp-circle\">Stamp<br>Here</div>\n              <div class=\"sav-sig-area\"></div>\n              <div class=\"sav-appr-name\">{{ doc.get('verified_by') or '_______________' }}</div>\n              <div class=\"sav-appr-label\">Senior Auditor / Reviewer</div>\n              <div class=\"sav-appr-date\">Date: _______________</div>\n            </td>\n            <td>\n              <div class=\"sav-appr-role\">Approved By</div>\n              <div class=\"sav-stamp-circle\">Stamp<br>Here</div>\n              <div class=\"sav-sig-area\"></div>\n              <div class=\"sav-appr-name\">{{ doc.get('approved_by') or '_______________' }}</div>\n              <div class=\"sav-appr-label\">Finance Manager / Director</div>\n              <div class=\"sav-appr-date\">Date: _______________</div>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </td></tr>\n  </tbody>\n</table>\n\n<!-- 11. FOOTER -->\n<table class=\"sav-footer\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td class=\"sav-footer-left\">{{ doc.company }} &nbsp;\u00b7&nbsp; Sales Auditing Voucher &nbsp;\u00b7&nbsp; Confidential</td>\n      <td class=\"sav-footer-mid\">Page 1 of 1 &nbsp;\u00b7&nbsp; Generated via ERPNext</td>\n      <td class=\"sav-footer-right\">Ref:&nbsp;<strong>{{ doc.name }}</strong> &nbsp;\u00b7&nbsp; {{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</td>\n    </tr>\n  </tbody>\n</table>\n\n</div>",
