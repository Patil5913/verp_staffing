{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-04-28 14:19:49.449512",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!-- ============================================================\n     ERPNext Sales Invoice \u2014 Professional Print Format\n     Theme    : Minimal White + #00AEF7 Blue Accent\n     Compatible with: ERPNext v13 / v14 / v15\n     ============================================================ -->\n\n{%- set currency_symbol = doc.currency -%}\n\n<style>\n/* \u2500\u2500 Reset & Base \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody, .print-format {\n  font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;\n  font-size: 12px;\n  color: #222;\n  background: #fff;\n  line-height: 1.5;\n}\n\n.inv-wrapper {\n  max-width: 860px;\n  margin: 0 auto;\n  background: #fff;\n}\n\n/* \u2500\u2500 HEADER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-header {\n  width: 100%;\n  border-collapse: collapse;\n  border-bottom: 3px solid #00AEF7;\n}\n\n.inv-header-company {\n  padding: 22px 0 18px;\n  vertical-align: top;\n  width: 55%;\n  border-right: 1px solid #e0e0e0;\n  padding-right: 24px;\n}\n\n.inv-header-title {\n  padding: 22px 0 18px 24px;\n  vertical-align: top;\n  text-align: right;\n  width: 45%;\n}\n\n.company-name {\n  font-size: 19px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 4px;\n}\n\n.company-meta {\n  font-size: 10.5px;\n  color: #666;\n  line-height: 1.75;\n}\n\n.invoice-label {\n  font-size: 24px;\n  font-weight: 900;\n  color: #111;\n  letter-spacing: 0.5px;\n  line-height: 1;\n  margin-bottom: 3px;\n}\n\n.invoice-eyebrow {\n  font-size: 8.5px;\n  font-weight: 700;\n  letter-spacing: 2.5px;\n  text-transform: uppercase;\n  color: #00AEF7;\n  margin-bottom: 10px;\n}\n\n.invoice-number {\n  font-size: 11px;\n  color: #888;\n  margin-bottom: 3px;\n}\n\n.invoice-number strong { color: #111; font-size: 12px; }\n\n/* \u2500\u2500 STATUS STRIP \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-strip {\n  width: 100%;\n  border-collapse: collapse;\n  background: #f0faff;\n  border-top: 1px solid #b3e0fd;\n  border-bottom: 1px solid #b3e0fd;\n}\n\n.inv-strip td {\n  padding: 6px 0;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  color: #888;\n  white-space: nowrap;\n}\n\n.inv-strip td span {\n  font-weight: 600;\n  text-transform: none;\n  margin-left: 4px;\n  letter-spacing: 0;\n  color: #222;\n}\n\n.inv-strip-div {\n  color: #b3e0fd !important;\n  font-size: 13px !important;\n  font-weight: 300 !important;\n  padding: 6px 8px !important;\n}\n\n/* \u2500\u2500 META: BILLING + DETAILS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-meta {\n  width: 100%;\n  border-collapse: collapse;\n  border-bottom: 1px solid #eee;\n}\n\n.inv-meta > tbody > tr > td {\n  padding: 16px 0 14px;\n  vertical-align: top;\n  border-right: 1px solid #f0f0f0;\n}\n\n.inv-meta > tbody > tr > td:last-child { border-right: none; }\n.inv-meta > tbody > tr > td + td { padding-left: 16px; }\n\n.meta-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.2px;\n  color: #00AEF7;\n  padding-bottom: 5px;\n  border-bottom: 1.5px solid #00AEF7;\n  margin-bottom: 9px;\n  display: block;\n}\n\n.meta-name {\n  font-size: 13px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 3px;\n}\n\n.meta-body {\n  font-size: 11px;\n  color: #444;\n  line-height: 1.7;\n}\n\n.meta-muted { font-size: 10.5px; color: #888; }\n\n/* Detail rows */\n.detail-table { width: 100%; border-collapse: collapse; }\n\n.detail-table tr td {\n  padding: 4px 0;\n  font-size: 11px;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.detail-table tr:last-child td { border-bottom: none; }\n.detail-table .dk { color: #888; width: 52%; }\n.detail-table .dv { color: #222; font-weight: 600; text-align: right; }\n\n/* \u2500\u2500 DIVIDER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-divider { border: none; border-top: 1px solid #eee; margin: 14px 0 0; }\n\n/* \u2500\u2500 ITEMS TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-items-table {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 14px;\n}\n\n.inv-items-table thead tr { background: #f0faff; }\n\n.inv-items-table thead th {\n  padding: 8px 10px;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: #444;\n  text-align: left;\n  border-top: 2px solid #00AEF7;\n  border-bottom: 1px solid #cde9fd;\n  border-right: 1px solid #ddf0fd;\n  white-space: nowrap;\n}\n\n.inv-items-table thead th:last-child { border-right: none; }\n.inv-items-table thead th.r { text-align: right; }\n\n.inv-items-table tbody tr { border-bottom: 1px solid #f2f2f2; }\n.inv-items-table tbody tr:nth-child(even) { background: #fafeff; }\n.inv-items-table tbody tr:last-child { border-bottom: 2px solid #cde9fd; }\n\n.inv-items-table tbody td {\n  padding: 9px 10px;\n  font-size: 11.5px;\n  color: #333;\n  vertical-align: top;\n  border-right: 1px solid #f2f2f2;\n}\n\n.inv-items-table tbody td:last-child { border-right: none; }\n.inv-items-table tbody td.r { text-align: right; font-variant-numeric: tabular-nums; }\n\n.sno-badge {\n  display: inline-block;\n  width: 20px;\n  height: 20px;\n  line-height: 20px;\n  text-align: center;\n  background: #e8f5fe;\n  border-radius: 2px;\n  font-size: 10px;\n  font-weight: 700;\n  color: #00AEF7;\n}\n\n.item-name { font-weight: 600; color: #111; margin-bottom: 2px; }\n.item-desc { font-size: 10px; color: #999; line-height: 1.4; }\n\n/* \u2500\u2500 TAX TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.tax-section { margin-top: 14px; }\n\n.tax-section-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.2px;\n  color: #00AEF7;\n  padding-bottom: 5px;\n  border-bottom: 1.5px solid #00AEF7;\n  margin-bottom: 9px;\n  display: block;\n}\n\n.tax-table { width: 100%; border-collapse: collapse; border: 1px solid #eee; }\n\n.tax-table thead th {\n  background: #f0faff;\n  color: #555;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  padding: 7px 10px;\n  text-align: left;\n  border-bottom: 1px solid #cde9fd;\n  border-right: 1px solid #eee;\n}\n\n.tax-table thead th:last-child { border-right: none; text-align: right; }\n\n.tax-table tbody td {\n  padding: 7px 10px;\n  font-size: 11px;\n  color: #333;\n  border-bottom: 1px solid #f5f5f5;\n  border-right: 1px solid #f5f5f5;\n}\n\n.tax-table tbody td:last-child { border-right: none; text-align: right; font-weight: 600; }\n.tax-table tbody tr:last-child td { border-bottom: none; }\n\n/* \u2500\u2500 TOTALS + NOTES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-bottom-wrap {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 14px;\n}\n\n.inv-bottom-wrap > tbody > tr > td {\n  padding: 0;\n  vertical-align: top;\n}\n\n/* Notes */\n.notes-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.2px;\n  color: #00AEF7;\n  padding-bottom: 5px;\n  border-bottom: 1.5px solid #00AEF7;\n  margin-bottom: 8px;\n  display: block;\n}\n\n.notes-text { font-size: 11px; color: #666; line-height: 1.65; }\n\n/* Totals */\n.totals-table { width: 100%; border-collapse: collapse; border: 1px solid #e8e8e8; }\n\n.totals-table tbody tr td {\n  padding: 7px 12px;\n  font-size: 11.5px;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.totals-table tbody tr:last-child td { border-bottom: none; }\n.totals-table .t-label { color: #666; }\n.totals-table .t-value { text-align: right; color: #222; font-weight: 600; font-variant-numeric: tabular-nums; }\n.totals-table .t-disc { color: #c0392b; }\n\n.totals-grand { background: #00AEF7 !important; }\n\n.totals-grand td {\n  padding: 11px 14px !important;\n  border-bottom: none !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  color: #fff !important;\n}\n\n.totals-grand .t-value {\n  color: #fff !important;\n  font-size: 16px !important;\n}\n\n.outstanding-box {\n  margin-top: 8px;\n  padding: 8px 12px;\n  background: #f0faff;\n  border: 1px solid #b3e0fd;\n  border-left: 3px solid #00AEF7;\n  font-size: 11px;\n  color: #333;\n}\n\n/* \u2500\u2500 AMOUNT IN WORDS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-in-words {\n  background: #f0faff;\n  border-left: 3px solid #00AEF7;\n  padding: 9px 14px;\n  margin-top: 14px;\n}\n\n.in-words-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: #00AEF7;\n  margin-bottom: 3px;\n}\n\n.in-words-text { font-size: 11.5px; color: #111; font-style: italic; font-weight: 500; }\n\n/* \u2500\u2500 PAYMENT DETAILS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-payment {\n  width: 100%;\n  border-collapse: collapse;\n  border: 1px solid #e8e8e8;\n  border-top: 2px solid #00AEF7;\n  margin-top: 14px;\n}\n\n.inv-payment > tbody > tr > td {\n  padding: 14px 16px;\n  vertical-align: top;\n  width: 50%;\n}\n\n.inv-payment > tbody > tr > td + td { border-left: 1px solid #f0f0f0; }\n\n.payment-title {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: #00AEF7;\n  padding-bottom: 6px;\n  border-bottom: 1px solid #e8e8e8;\n  margin-bottom: 10px;\n  display: block;\n}\n\n.pay-table { width: 100%; border-collapse: collapse; }\n\n.pay-table tr td { padding: 4px 0; font-size: 11px; border-bottom: 1px solid #f8f8f8; }\n.pay-table tr:last-child td { border-bottom: none; }\n.pay-table .pk { color: #888; }\n.pay-table .pv { text-align: right; color: #222; font-weight: 600; }\n\n.pay-total-row td { border-top: 1.5px solid #e8e8e8 !important; padding-top: 8px !important; }\n.pay-total-row .pk { font-weight: 700; color: #111 !important; }\n.pay-total-row .pv { color: #00AEF7 !important; font-size: 13px !important; }\n\n/* \u2500\u2500 SIGNATURE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-sig {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 22px;\n}\n\n.inv-sig > tbody > tr > td {\n  padding: 0;\n  text-align: center;\n  vertical-align: bottom;\n}\n\n.sig-line {\n  border-top: 1.5px solid #00AEF7;\n  width: 160px;\n  margin: 0 auto 6px;\n}\n\n.sig-label {\n  font-size: 9.5px;\n  color: #888;\n  text-transform: uppercase;\n  letter-spacing: 0.8px;\n  font-weight: 600;\n}\n\n.sig-note { font-size: 10px; color: #bbb; font-style: italic; }\n\n/* \u2500\u2500 FOOTER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.inv-footer {\n  width: 100%;\n  border-collapse: collapse;\n  border-top: 2px solid #00AEF7;\n  margin-top: 22px;\n}\n\n.inv-footer td { padding: 10px 0; font-size: 9.5px; }\n.footer-left  { color: #aaa; font-style: italic; }\n.footer-right { text-align: right; color: #888; }\n.footer-right strong { color: #00AEF7; }\n\n/* \u2500\u2500 UTILITY \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.muted { color: #aaa; }\n.fw6   { font-weight: 600; }\n.fw7   { font-weight: 700; }\n.ta-r  { text-align: right; }\n\n@media print {\n  body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n  .inv-wrapper { max-width: 100%; }\n}\n</style>\n\n<div class=\"inv-wrapper\">\n\n<!-- 1. HEADER -->\n<table class=\"inv-header\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td class=\"inv-header-company\">\n        {% if doc.company_logo %}\n          <img src=\"{{ doc.company_logo }}\" alt=\"{{ doc.company }}\"\n               style=\"max-height:42px; margin-bottom:8px; display:block;\">\n        {% endif %}\n        <div class=\"company-name\">{{ doc.company }}</div>\n        <div class=\"company-meta\">\n          {% if doc.company_address %}{{ doc.company_address | replace('\\n', '<br>') }}{% endif %}\n          {% if doc.get('company_gstin') %}<br>GSTIN: {{ doc.company_gstin }}{% endif %}\n          {% if doc.get('company_pan') %}&nbsp;&nbsp;|&nbsp;&nbsp;PAN: {{ doc.company_pan }}{% endif %}\n        </div>\n      </td>\n      <td class=\"inv-header-title\">\n        <div class=\"invoice-eyebrow\">Tax Invoice</div>\n        <div class=\"invoice-label\">Invoice</div>\n        <div class=\"invoice-number\" style=\"margin-top:6px;\">Document No.&nbsp;<strong>{{ doc.name }}</strong></div>\n        <div class=\"invoice-number\" style=\"margin-top:2px;\">Date:&nbsp;<strong>{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</strong></div>\n        {% if doc.get('is_return') %}\n        <div style=\"margin-top:8px;\">\n          <span style=\"background:#00AEF7; color:#fff; padding:3px 10px; font-size:9px; font-weight:800; letter-spacing:1px; text-transform:uppercase; border-radius:2px;\">\n            Credit Note\n          </span>\n        </div>\n        {% endif %}\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 2. STATUS STRIP -->\n<table class=\"inv-strip\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td>Invoice Date <span>{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</span></td>\n      <td class=\"inv-strip-div\">|</td>\n      <td>Due Date <span>{{ frappe.format(doc.due_date, {'fieldtype': 'Date'}) if doc.due_date else '\u2014' }}</span></td>\n      {% if doc.payment_terms_template %}\n      <td class=\"inv-strip-div\">|</td>\n      <td>Terms <span>{{ doc.payment_terms_template }}</span></td>\n      {% endif %}\n      <td class=\"inv-strip-div\">|</td>\n      <td>Currency <span>{{ doc.currency }}</span></td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 3. META -->\n<table class=\"inv-meta\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n\n      <!-- Bill To -->\n      <td style=\"width:36%;\">\n        <span class=\"meta-label\">Bill To</span>\n        <div class=\"meta-name\">{{ doc.customer }}</div>\n        <div class=\"meta-body\">\n          {% if doc.customer_address %}{{ doc.customer_address | replace('\\n', '<br>') }}{% endif %}\n          {% if doc.contact_display %}<br><span class=\"meta-muted\">Attn: {{ doc.contact_display }}</span>{% endif %}\n          {% if doc.get('contact_email') %}<br><span class=\"meta-muted\">{{ doc.contact_email }}</span>{% endif %}\n          {% if doc.get('customer_gstin') %}<br><span class=\"meta-muted\">GSTIN: {{ doc.customer_gstin }}</span>{% endif %}\n        </div>\n      </td>\n\n      <!-- Ship To -->\n      {% if doc.get('shipping_address_name') and doc.shipping_address_name != doc.customer_address %}\n      <td style=\"width:28%; padding-left:16px;\">\n        <span class=\"meta-label\">Ship To</span>\n        <div class=\"meta-name\">{{ doc.customer }}</div>\n        <div class=\"meta-body\">{{ doc.shipping_address | replace('\\n', '<br>') }}</div>\n      </td>\n      {% endif %}\n\n      <!-- Invoice Details -->\n      <td style=\"{% if doc.get('shipping_address_name') and doc.shipping_address_name != doc.customer_address %}width:36%{% else %}width:64%{% endif %}; padding-left:16px;\">\n        <span class=\"meta-label\">Invoice Details</span>\n        <table class=\"detail-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            <tr><td class=\"dk\">Purchase Order</td><td class=\"dv\">{{ doc.po_no if doc.po_no else '\u2014' }}</td></tr>\n            {% if doc.po_date %}<tr><td class=\"dk\">PO Date</td><td class=\"dv\">{{ frappe.format(doc.po_date, {'fieldtype': 'Date'}) }}</td></tr>{% endif %}\n            <tr><td class=\"dk\">Place of Supply</td><td class=\"dv\">{{ doc.place_of_supply if doc.place_of_supply else '\u2014' }}</td></tr>\n            {% if doc.cost_center %}<tr><td class=\"dk\">Cost Centre</td><td class=\"dv\">{{ doc.cost_center }}</td></tr>{% endif %}\n            {% if doc.territory %}<tr><td class=\"dk\">Territory</td><td class=\"dv\">{{ doc.territory }}</td></tr>{% endif %}\n            {% if doc.sales_team %}\n            <tr>\n              <td class=\"dk\">Sales Person</td>\n              <td class=\"dv\">{% for p in doc.sales_team %}{{ p.sales_person }}{% if not loop.last %}, {% endif %}{% endfor %}</td>\n            </tr>\n            {% endif %}\n          </tbody>\n        </table>\n      </td>\n\n    </tr>\n  </tbody>\n</table>\n\n<hr class=\"inv-divider\">\n\n<!-- 4. ITEMS TABLE -->\n<table class=\"inv-items-table\" cellpadding=\"0\" cellspacing=\"0\">\n  <thead>\n    <tr>\n      <th style=\"width:34px;\">#</th>\n      <th>Item &amp; Description</th>\n      <th class=\"r\" style=\"width:82px;\">HSN / SAC</th>\n      <th class=\"r\" style=\"width:64px;\">Qty</th>\n      <th class=\"r\" style=\"width:48px;\">UOM</th>\n      <th class=\"r\" style=\"width:96px;\">Rate ({{ doc.currency }})</th>\n      {% if doc.get('discount_amount') or doc.get('additional_discount_percentage') %}\n      <th class=\"r\" style=\"width:72px;\">Disc.</th>\n      {% endif %}\n      <th class=\"r\" style=\"width:104px;\">Amount ({{ doc.currency }})</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for item in doc.items %}\n    {%- set icode = item.get('item_code') or '' -%}\n    {%- set iname = item.get('item_name') or '' -%}\n    {%- set idesc = item.get('description') or '' -%}\n    {%- set ihsn  = item.get('gst_hsn_code') or '' -%}\n    {%- set idisc = item.get('discount_percentage') or 0 -%}\n    <tr>\n      <td><span class=\"sno-badge\">{{ loop.index }}</span></td>\n      <td>\n        <div class=\"item-name\">{{ iname }}</div>\n        {% if idesc and idesc != iname %}<div class=\"item-desc\">{{ idesc | striptags | truncate(180) }}</div>{% endif %}\n        {% if icode and icode != iname %}<div class=\"item-desc\" style=\"margin-top:1px;\">Code: {{ icode }}</div>{% endif %}\n      </td>\n      <td class=\"r muted\">{{ ihsn if ihsn else '\u2014' }}</td>\n      <td class=\"r fw6\">{{ item.qty | int if item.qty == item.qty | int else item.qty }}</td>\n      <td class=\"r muted\">{{ item.uom }}</td>\n      <td class=\"r\">{{ frappe.format(item.rate, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n      {% if doc.get('discount_amount') or doc.get('additional_discount_percentage') %}\n      <td class=\"r\" style=\"color:#c0392b;\">{% if idisc %}{{ idisc }}%{% else %}\u2014{% endif %}</td>\n      {% endif %}\n      <td class=\"r fw6\">{{ frappe.format(item.amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n\n<!-- 5. TAX BREAKDOWN -->\n{% if doc.taxes %}\n<div class=\"tax-section\">\n  <span class=\"tax-section-label\">Tax Breakdown</span>\n  <table class=\"tax-table\" cellpadding=\"0\" cellspacing=\"0\">\n    <thead>\n      <tr>\n        <th>Tax / Charge</th>\n        <th>Account Head</th>\n        <th style=\"text-align:right;\">Rate</th>\n        <th>Amount ({{ doc.currency }})</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for tax in doc.taxes %}\n      <tr>\n        <td>{{ tax.description }}</td>\n        <td style=\"color:#aaa;\">{{ tax.account_head }}</td>\n        <td style=\"text-align:right;\">{{ tax.rate }}%</td>\n        <td>{{ frappe.format(tax.tax_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n</div>\n{% endif %}\n\n<!-- 6. NOTES + TOTALS -->\n<table class=\"inv-bottom-wrap\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"width:47%; padding-right:16px; vertical-align:top;\">\n        {% if doc.terms %}\n        <span class=\"notes-label\">Terms &amp; Conditions</span>\n        <div class=\"notes-text\">{{ doc.terms | striptags }}</div>\n        {% endif %}\n        {% if doc.remarks %}\n        <span class=\"notes-label\" style=\"display:block; margin-top:12px;\">Remarks</span>\n        <div class=\"notes-text\">{{ doc.remarks }}</div>\n        {% endif %}\n      </td>\n      <td style=\"width:6%;\"></td>\n      <td style=\"width:47%; vertical-align:top;\">\n        <table class=\"totals-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            <tr>\n              <td class=\"t-label\">Sub Total</td>\n              <td class=\"t-value\">{{ frappe.format(doc.net_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n            {% if doc.get('discount_amount') %}\n            <tr>\n              <td class=\"t-label t-disc\">Discount{% if doc.get('additional_discount_percentage') %} ({{ doc.additional_discount_percentage }}%){% endif %}</td>\n              <td class=\"t-value t-disc\">\u2212 {{ frappe.format(doc.discount_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n            {% endif %}\n            {% for tax in doc.taxes %}\n            <tr>\n              <td class=\"t-label\">{{ tax.description }}{% if tax.rate %} ({{ tax.rate }}%){% endif %}</td>\n              <td class=\"t-value\">{{ frappe.format(tax.tax_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n            {% endfor %}\n            {% if doc.get('rounding_adjustment') and doc.rounding_adjustment != 0 %}\n            <tr>\n              <td class=\"t-label\">Rounding</td>\n              <td class=\"t-value\">{{ frappe.format(doc.rounding_adjustment, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n            {% endif %}\n            <tr class=\"totals-grand\">\n              <td class=\"t-label\" style=\"color:#fff;\">Total Due</td>\n              <td class=\"t-value\">{{ frappe.format(doc.grand_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n          </tbody>\n        </table>\n        {% if doc.get('outstanding_amount') and doc.outstanding_amount != doc.grand_total %}\n        <div class=\"outstanding-box\">\n          <strong>Outstanding Amount:&nbsp;</strong>\n          {{ frappe.format(doc.outstanding_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}\n        </div>\n        {% endif %}\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 7. AMOUNT IN WORDS -->\n{% if doc.in_words %}\n<div class=\"inv-in-words\">\n  <div class=\"in-words-label\">Amount in Words</div>\n  <div class=\"in-words-text\">{{ doc.in_words }}</div>\n</div>\n{% endif %}\n\n<!-- 8. PAYMENT DETAILS -->\n<table class=\"inv-payment\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td>\n        <span class=\"payment-title\">Bank Details</span>\n        <table class=\"pay-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            {% if doc.get('company_bank_account') %}<tr><td class=\"pk\">Bank</td><td class=\"pv\">{{ doc.company_bank_account }}</td></tr>{% endif %}\n            {% if doc.get('bank_account_no') %}<tr><td class=\"pk\">Account No.</td><td class=\"pv\">{{ doc.bank_account_no }}</td></tr>{% endif %}\n            {% if doc.get('bank_ifsc') %}<tr><td class=\"pk\">IFSC Code</td><td class=\"pv\">{{ doc.bank_ifsc }}</td></tr>{% endif %}\n            <tr><td class=\"pk\">Reference</td><td class=\"pv\">{{ doc.name }}</td></tr>\n          </tbody>\n        </table>\n      </td>\n      <td>\n        <span class=\"payment-title\">Invoice Summary</span>\n        <table class=\"pay-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            <tr><td class=\"pk\">Invoice No.</td><td class=\"pv\">{{ doc.name }}</td></tr>\n            <tr><td class=\"pk\">Invoice Date</td><td class=\"pv\">{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</td></tr>\n            <tr><td class=\"pk\">Due Date</td><td class=\"pv\">{{ frappe.format(doc.due_date, {'fieldtype': 'Date'}) if doc.due_date else '\u2014' }}</td></tr>\n            <tr class=\"pay-total-row\">\n              <td class=\"pk\">Amount Due</td>\n              <td class=\"pv\">{{ frappe.format(doc.grand_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n          </tbody>\n        </table>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 9. SIGNATURE -->\n<table class=\"inv-sig\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"width:33%;\">\n        <div class=\"sig-line\"></div>\n        <div class=\"sig-label\">Authorised Signatory</div>\n        <div style=\"font-size:11px; color:#111; font-weight:600; margin-top:3px;\">{{ doc.company }}</div>\n      </td>\n      <td style=\"width:34%; vertical-align:middle;\">\n        <div class=\"sig-note\">This is a computer-generated invoice<br>and does not require a physical signature.</div>\n      </td>\n      <td style=\"width:33%;\">\n        <div class=\"sig-line\"></div>\n        <div class=\"sig-label\">Customer Acknowledgement</div>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 10. FOOTER -->\n<table class=\"inv-footer\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td class=\"footer-left\">Thank you for your business.</td>\n      <td class=\"footer-right\">Generated via ERPNext &nbsp;\u00b7&nbsp; Ref:&nbsp;<strong>{{ doc.name }}</strong></td>\n    </tr>\n  </tbody>\n</table>\n\n</div>",
