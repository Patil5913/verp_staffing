{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-04-28 14:19:49.449512",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!-- ============================================================\n     ERPNext Sales Invoice \u2014 Professional Print Format\n     Compatible with: ERPNext v13 / v14 / v15\n     Templating: Jinja2 (ERPNext standard)\n     Author: ByteWave Technology\n     ============================================================ -->\n\n{%- set currency_symbol = doc.currency -%}\n\n<style>\n  /* \u2500\u2500 Reset & Base \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  body, .print-format {\n    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;\n    font-size: 13px;\n    color: #1a2340;\n    background: #fff;\n    line-height: 1.5;\n  }\n\n  /* \u2500\u2500 Page Wrapper \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-wrapper {\n    max-width: 860px;\n    margin: 0 auto;\n    padding: 0;\n    background: #fff;\n  }\n\n  /* \u2500\u2500 Header Band \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-header {\n    background: linear-gradient(135deg, #0d1b3e 0%, #102a5a 60%, #0e3a6e 100%);\n    padding: 36px 40px 30px;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .inv-header::before {\n    content: '';\n    position: absolute;\n    top: -30px; right: -30px;\n    width: 180px; height: 180px;\n    border-radius: 50%;\n    background: rgba(0, 198, 210, 0.12);\n  }\n\n  .inv-header::after {\n    content: '';\n    position: absolute;\n    bottom: -50px; right: 80px;\n    width: 120px; height: 120px;\n    border-radius: 50%;\n    background: rgba(0, 198, 210, 0.07);\n  }\n\n  .inv-header-inner {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    position: relative;\n    z-index: 1;\n  }\n\n  /* Company block */\n  .company-block {}\n\n  .company-name {\n    font-size: 22px;\n    font-weight: 700;\n    color: #ffffff;\n    letter-spacing: 0.3px;\n    margin-bottom: 6px;\n  }\n\n  .company-meta {\n    font-size: 11.5px;\n    color: rgba(255,255,255,0.65);\n    line-height: 1.7;\n  }\n\n  /* Invoice title block */\n  .invoice-title-block {\n    text-align: right;\n  }\n\n  .invoice-label {\n    font-size: 32px;\n    font-weight: 800;\n    color: #00c6d2;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    line-height: 1;\n    margin-bottom: 8px;\n  }\n\n  .invoice-number {\n    font-size: 13px;\n    color: rgba(255,255,255,0.55);\n    letter-spacing: 0.5px;\n    margin-bottom: 4px;\n  }\n\n  .invoice-number strong {\n    color: #ffffff;\n    font-size: 14px;\n  }\n\n  /* \u2500\u2500 Status Strip \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-status-strip {\n    background: #00c6d2;\n    padding: 7px 40px;\n    display: flex;\n    justify-content: flex-end;\n    align-items: center;\n    gap: 24px;\n  }\n\n  .status-item {\n    font-size: 11px;\n    color: #0d1b3e;\n    font-weight: 600;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n  }\n\n  .status-item span {\n    font-weight: 400;\n    text-transform: none;\n    margin-left: 5px;\n    letter-spacing: 0;\n  }\n\n  .status-divider {\n    color: rgba(13,27,62,0.35);\n    font-size: 14px;\n  }\n\n  /* \u2500\u2500 Billing & Info Grid \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-meta {\n    padding: 28px 40px 20px;\n    display: flex;\n    gap: 0;\n  }\n\n  .meta-col {\n    flex: 1;\n  }\n\n  .meta-col + .meta-col {\n    border-left: 1px solid #edf0f5;\n    padding-left: 32px;\n    margin-left: 32px;\n  }\n\n  .meta-label {\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    color: #00c6d2;\n    margin-bottom: 8px;\n    padding-bottom: 6px;\n    border-bottom: 2px solid #edf0f5;\n  }\n\n  .meta-value {\n    font-size: 13px;\n    color: #1a2340;\n    line-height: 1.6;\n  }\n\n  .meta-value strong {\n    font-size: 14px;\n    font-weight: 700;\n    display: block;\n    margin-bottom: 2px;\n    color: #0d1b3e;\n  }\n\n  /* Invoice details mini-table */\n  .detail-row {\n    display: flex;\n    justify-content: space-between;\n    padding: 4px 0;\n    border-bottom: 1px dashed #edf0f5;\n    font-size: 12.5px;\n  }\n\n  .detail-row:last-child { border-bottom: none; }\n\n  .detail-row .dk { color: #5a6a8a; font-weight: 500; }\n  .detail-row .dv { color: #1a2340; font-weight: 600; text-align: right; }\n\n  /* \u2500\u2500 Items Table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-items {\n    padding: 0 40px;\n    margin-top: 4px;\n  }\n\n  .items-table {\n    width: 100%;\n    border-collapse: collapse;\n    border-radius: 8px;\n    overflow: hidden;\n  }\n\n  .items-table thead tr {\n    background: #0d1b3e;\n    color: #fff;\n  }\n\n  .items-table thead th {\n    padding: 11px 14px;\n    font-size: 10.5px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    text-align: left;\n    white-space: nowrap;\n  }\n\n  .items-table thead th:last-child,\n  .items-table thead th.num { text-align: right; }\n\n  .items-table tbody tr {\n    border-bottom: 1px solid #edf0f5;\n    transition: background 0.15s;\n  }\n\n  .items-table tbody tr:nth-child(even) {\n    background: #f7f9fc;\n  }\n\n  .items-table tbody tr:last-child {\n    border-bottom: 2px solid #0d1b3e;\n  }\n\n  .items-table tbody td {\n    padding: 11px 14px;\n    font-size: 12.5px;\n    color: #2d3a55;\n    vertical-align: top;\n  }\n\n  .items-table tbody td.num { text-align: right; font-variant-numeric: tabular-nums; }\n\n  .item-name {\n    font-weight: 600;\n    color: #0d1b3e;\n    margin-bottom: 2px;\n  }\n\n  .item-desc {\n    font-size: 11px;\n    color: #7a8aaa;\n    line-height: 1.4;\n  }\n\n  .sno-badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 22px; height: 22px;\n    background: #eef1f8;\n    border-radius: 50%;\n    font-size: 11px;\n    font-weight: 700;\n    color: #5a6a8a;\n  }\n\n  /* \u2500\u2500 Totals Section \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-footer-row {\n    display: flex;\n    padding: 20px 40px 0;\n    gap: 24px;\n    align-items: flex-start;\n  }\n\n  /* Notes / Terms */\n  .inv-notes {\n    flex: 1;\n  }\n\n  .notes-label {\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    color: #00c6d2;\n    margin-bottom: 8px;\n    padding-bottom: 5px;\n    border-bottom: 2px solid #edf0f5;\n  }\n\n  .notes-text {\n    font-size: 11.5px;\n    color: #7a8aaa;\n    line-height: 1.6;\n  }\n\n  /* Totals block */\n  .inv-totals {\n    min-width: 280px;\n  }\n\n  .totals-table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n\n  .totals-table tr td {\n    padding: 7px 12px;\n    font-size: 12.5px;\n    border-bottom: 1px dashed #edf0f5;\n  }\n\n  .totals-table tr:last-child td { border-bottom: none; }\n\n  .totals-table .t-label { color: #5a6a8a; font-weight: 500; }\n  .totals-table .t-value { text-align: right; color: #1a2340; font-weight: 600; font-variant-numeric: tabular-nums; }\n\n  .totals-table tr.discount-row td { color: #e05a3a; }\n  .totals-table tr.discount-row .t-value { color: #e05a3a; }\n\n  .totals-grand {\n    background: #0d1b3e;\n    border-radius: 0 0 8px 8px;\n    margin-top: 0;\n    overflow: hidden;\n  }\n\n  .totals-grand td {\n    padding: 13px 16px !important;\n    border-bottom: none !important;\n    font-size: 14px !important;\n    font-weight: 700 !important;\n    color: #fff !important;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .totals-grand .t-value {\n    color: #00c6d2 !important;\n    font-size: 18px !important;\n    letter-spacing: 0;\n  }\n\n  /* \u2500\u2500 Amount in Words \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-in-words {\n    margin: 16px 40px 0;\n    background: #f7f9fc;\n    border-left: 3px solid #00c6d2;\n    padding: 10px 16px;\n    border-radius: 0 6px 6px 0;\n  }\n\n  .in-words-label {\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    color: #5a6a8a;\n    margin-bottom: 3px;\n  }\n\n  .in-words-text {\n    font-size: 12.5px;\n    color: #0d1b3e;\n    font-style: italic;\n    font-weight: 500;\n  }\n\n  /* \u2500\u2500 Payment Details \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-payment {\n    margin: 20px 40px 0;\n    border: 1px solid #edf0f5;\n    border-radius: 8px;\n    padding: 16px 20px;\n    display: flex;\n    gap: 32px;\n    background: #fafbfd;\n  }\n\n  .payment-section {\n    flex: 1;\n  }\n\n  .payment-title {\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    color: #00c6d2;\n    margin-bottom: 10px;\n    padding-bottom: 6px;\n    border-bottom: 2px solid #edf0f5;\n  }\n\n  .payment-row {\n    display: flex;\n    justify-content: space-between;\n    font-size: 12px;\n    padding: 3px 0;\n  }\n\n  .payment-row .pk { color: #7a8aaa; }\n  .payment-row .pv { color: #1a2340; font-weight: 600; }\n\n  /* \u2500\u2500 Signature Row \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-signature {\n    margin: 24px 40px 0;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n  }\n\n  .sig-block {\n    text-align: center;\n    min-width: 160px;\n  }\n\n  .sig-line {\n    border-top: 1.5px solid #0d1b3e;\n    margin-bottom: 6px;\n    width: 160px;\n  }\n\n  .sig-label {\n    font-size: 10.5px;\n    color: #7a8aaa;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    font-weight: 600;\n  }\n\n  /* \u2500\u2500 Bottom Footer \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .inv-bottom {\n    margin-top: 28px;\n    background: #0d1b3e;\n    padding: 14px 40px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .bottom-tagline {\n    font-size: 11px;\n    color: rgba(255,255,255,0.45);\n    font-style: italic;\n  }\n\n  .bottom-doc-ref {\n    font-size: 11px;\n    color: rgba(255,255,255,0.5);\n    letter-spacing: 0.3px;\n  }\n\n  .bottom-doc-ref strong {\n    color: #00c6d2;\n  }\n\n  /* \u2500\u2500 Tax Table (collapsible section) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .tax-section {\n    padding: 0 40px;\n    margin-top: 16px;\n  }\n\n  .tax-header {\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    color: #00c6d2;\n    padding-bottom: 6px;\n    border-bottom: 2px solid #edf0f5;\n    margin-bottom: 8px;\n  }\n\n  .tax-table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n\n  .tax-table th {\n    background: #f0f3f9;\n    color: #5a6a8a;\n    font-size: 10.5px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    padding: 7px 12px;\n    text-align: left;\n  }\n\n  .tax-table th:last-child { text-align: right; }\n\n  .tax-table td {\n    padding: 7px 12px;\n    font-size: 12px;\n    color: #2d3a55;\n    border-bottom: 1px solid #edf0f5;\n  }\n\n  .tax-table td:last-child { text-align: right; font-weight: 600; }\n\n  /* \u2500\u2500 Utilities \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .text-right { text-align: right; }\n  .text-center { text-align: center; }\n  .fw-600 { font-weight: 600; }\n  .color-muted { color: #7a8aaa; }\n  .mt-4 { margin-top: 4px; }\n  .section-divider {\n    border: none;\n    border-top: 1px solid #edf0f5;\n    margin: 20px 40px;\n  }\n\n  @media print {\n    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n  }\n</style>\n\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n     INVOICE WRAPPER\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n<div class=\"inv-wrapper\">\n\n  <!-- \u2500\u2500 HEADER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-header\">\n    <div class=\"inv-header-inner\">\n\n      <!-- Company Info -->\n      <div class=\"company-block\">\n        {% if doc.company_logo %}\n          <img src=\"{{ doc.company_logo }}\" alt=\"{{ doc.company }}\"\n               style=\"max-height:52px; margin-bottom:10px; display:block; filter:brightness(0) invert(1);\">\n        {% endif %}\n        <div class=\"company-name\">{{ doc.company }}</div>\n        <div class=\"company-meta\">\n          {% if doc.company_address %}\n            {{ doc.company_address | replace('\\n', '<br>') }}\n          {% endif %}\n          {% if doc.get('company_gstin') %}<br>GSTIN: {{ doc.company_gstin }}{% endif %}\n          {% if doc.get('company_pan') %}&nbsp;&nbsp;|&nbsp;&nbsp;PAN: {{ doc.company_pan }}{% endif %}\n        </div>\n      </div>\n\n      <!-- Invoice Label & Number -->\n      <div class=\"invoice-title-block\">\n        <div class=\"invoice-label\">Invoice</div>\n        <div class=\"invoice-number\">\n          Document No.&nbsp;<strong>#{{ doc.name }}</strong>\n        </div>\n        {% if doc.get('is_return') %}\n          <div style=\"margin-top:6px;\">\n            <span style=\"background:#e05a3a;color:#fff;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;\">\n              Credit Note\n            </span>\n          </div>\n        {% endif %}\n      </div>\n\n    </div>\n  </div>\n  <!-- END HEADER -->\n\n  <!-- \u2500\u2500 STATUS STRIP \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-status-strip\">\n    <div class=\"status-item\">\n      Invoice Date <span>{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</span>\n    </div>\n    <div class=\"status-divider\">|</div>\n    <div class=\"status-item\">\n      Due Date <span>{{ frappe.format(doc.due_date, {'fieldtype': 'Date'}) if doc.due_date else '\u2014' }}</span>\n    </div>\n    {% if doc.payment_terms_template %}\n    <div class=\"status-divider\">|</div>\n    <div class=\"status-item\">\n      Terms <span>{{ doc.payment_terms_template }}</span>\n    </div>\n    {% endif %}\n    <div class=\"status-divider\">|</div>\n    <div class=\"status-item\">\n      Currency <span>{{ doc.currency }}</span>\n    </div>\n  </div>\n  <!-- END STATUS STRIP -->\n\n  <!-- \u2500\u2500 META: BILLING + SHIPPING + DETAILS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-meta\">\n\n    <!-- Bill To -->\n    <div class=\"meta-col\">\n      <div class=\"meta-label\">Bill To</div>\n      <div class=\"meta-value\">\n        <strong>{{ doc.customer }}</strong>\n        {% if doc.customer_address %}\n          {{ doc.customer_address | replace('\\n', '<br>') }}\n        {% endif %}\n        {% if doc.contact_display %}\n          <br><span style=\"color:#5a6a8a;font-size:11.5px;\">Attn: {{ doc.contact_display }}</span>\n        {% endif %}\n        {% if doc.get('contact_email') %}\n          <br><span style=\"color:#5a6a8a;font-size:11.5px;\">{{ doc.contact_email }}</span>\n        {% endif %}\n        {% if doc.get('customer_gstin') %}\n          <br><span style=\"color:#5a6a8a;font-size:11.5px;\">GSTIN: {{ doc.customer_gstin }}</span>\n        {% endif %}\n      </div>\n    </div>\n\n    <!-- Ship To (if different) -->\n    {% if doc.get('shipping_address_name') and doc.shipping_address_name != doc.customer_address %}\n    <div class=\"meta-col\">\n      <div class=\"meta-label\">Ship To</div>\n      <div class=\"meta-value\">\n        <strong>{{ doc.customer }}</strong>\n        {{ doc.shipping_address | replace('\\n', '<br>') }}\n      </div>\n    </div>\n    {% endif %}\n\n    <!-- Invoice Details -->\n    <div class=\"meta-col\">\n      <div class=\"meta-label\">Invoice Details</div>\n      <div class=\"meta-value\">\n\n        <div class=\"detail-row\">\n          <span class=\"dk\">Purchase Order</span>\n          <span class=\"dv\">{{ doc.po_no if doc.po_no else '\u2014' }}</span>\n        </div>\n\n        {% if doc.po_date %}\n        <div class=\"detail-row\">\n          <span class=\"dk\">PO Date</span>\n          <span class=\"dv\">{{ frappe.format(doc.po_date, {'fieldtype': 'Date'}) }}</span>\n        </div>\n        {% endif %}\n\n        <div class=\"detail-row\">\n          <span class=\"dk\">Place of Supply</span>\n          <span class=\"dv\">{{ doc.place_of_supply if doc.place_of_supply else '\u2014' }}</span>\n        </div>\n\n        {% if doc.cost_center %}\n        <div class=\"detail-row\">\n          <span class=\"dk\">Cost Centre</span>\n          <span class=\"dv\">{{ doc.cost_center }}</span>\n        </div>\n        {% endif %}\n\n        {% if doc.territory %}\n        <div class=\"detail-row\">\n          <span class=\"dk\">Territory</span>\n          <span class=\"dv\">{{ doc.territory }}</span>\n        </div>\n        {% endif %}\n\n        {% if doc.sales_team %}\n        <div class=\"detail-row\">\n          <span class=\"dk\">Sales Person</span>\n          <span class=\"dv\">\n            {% for person in doc.sales_team %}{{ person.sales_person }}{% if not loop.last %}, {% endif %}{% endfor %}\n          </span>\n        </div>\n        {% endif %}\n\n      </div>\n    </div>\n\n  </div>\n  <!-- END META -->\n\n  <hr class=\"section-divider\">\n\n  <!-- \u2500\u2500 LINE ITEMS TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-items\">\n    <table class=\"items-table\">\n      <thead>\n        <tr>\n          <th style=\"width:36px;\">#</th>\n          <th>Item &amp; Description</th>\n          <th class=\"num\" style=\"width:90px;\">HSN / SAC</th>\n          <th class=\"num\" style=\"width:72px;\">Qty</th>\n          <th class=\"num\" style=\"width:52px;\">UOM</th>\n          <th class=\"num\" style=\"width:100px;\">Rate ({{ doc.currency }})</th>\n          {% if doc.get('discount_amount') or doc.get('additional_discount_percentage') %}\n          <th class=\"num\" style=\"width:80px;\">Discount</th>\n          {% endif %}\n          <th class=\"num\" style=\"width:110px;\">Amount ({{ doc.currency }})</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for item in doc.items %}\n        {%- set icode = item.get('item_code') or '' -%}\n        {%- set iname = item.get('item_name') or '' -%}\n        {%- set idesc = item.get('description') or '' -%}\n        {%- set ihsn  = item.get('gst_hsn_code') or '' -%}\n        {%- set idisc = item.get('discount_percentage') or 0 -%}\n        <tr>\n          <td><span class=\"sno-badge\">{{ loop.index }}</span></td>\n          <td>\n            <div class=\"item-name\">{{ iname }}</div>\n            {% if idesc and idesc != iname %}\n              <div class=\"item-desc\">{{ idesc | striptags | truncate(180) }}</div>\n            {% endif %}\n            {% if icode and icode != iname %}\n              <div class=\"item-desc\" style=\"margin-top:2px;\">Code: {{ icode }}</div>\n            {% endif %}\n          </td>\n          <td class=\"num color-muted\">{{ ihsn if ihsn else '\u2014' }}</td>\n          <td class=\"num fw-600\">{{ item.qty | int if item.qty == item.qty | int else item.qty }}</td>\n          <td class=\"num color-muted\">{{ item.uom }}</td>\n          <td class=\"num\">{{ frappe.format(item.rate, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n          {% if doc.get('discount_amount') or doc.get('additional_discount_percentage') %}\n          <td class=\"num\" style=\"color:#e05a3a;\">\n            {% if idisc %}{{ idisc }}%{% else %}\u2014{% endif %}\n          </td>\n          {% endif %}\n          <td class=\"num fw-600\">{{ frappe.format(item.amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n  </div>\n  <!-- END LINE ITEMS -->\n\n  <!-- \u2500\u2500 TAX BREAKDOWN (if GST taxes exist) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  {% if doc.taxes %}\n  <div class=\"tax-section\" style=\"margin-top:20px;\">\n    <div class=\"tax-header\">Tax Breakdown</div>\n    <table class=\"tax-table\">\n      <thead>\n        <tr>\n          <th>Tax / Charge</th>\n          <th>Account Head</th>\n          <th style=\"text-align:right;\">Rate</th>\n          <th style=\"text-align:right;\">Amount ({{ doc.currency }})</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for tax in doc.taxes %}\n        <tr>\n          <td>{{ tax.description }}</td>\n          <td style=\"color:#7a8aaa;\">{{ tax.account_head }}</td>\n          <td style=\"text-align:right;\">{{ tax.rate }}%</td>\n          <td>{{ frappe.format(tax.tax_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n  </div>\n  {% endif %}\n  <!-- END TAX BREAKDOWN -->\n\n  <!-- \u2500\u2500 FOOTER ROW: NOTES + TOTALS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-footer-row\" style=\"margin-top:20px;\">\n\n    <!-- Notes & Terms -->\n    <div class=\"inv-notes\">\n      {% if doc.terms %}\n      <div class=\"notes-label\">Terms &amp; Conditions</div>\n      <div class=\"notes-text\">{{ doc.terms | striptags }}</div>\n      {% endif %}\n\n      {% if doc.remarks %}\n      <div class=\"notes-label\" style=\"margin-top:14px;\">Remarks</div>\n      <div class=\"notes-text\">{{ doc.remarks }}</div>\n      {% endif %}\n    </div>\n\n    <!-- Totals -->\n    <div class=\"inv-totals\">\n      <table class=\"totals-table\" style=\"border:1px solid #edf0f5; border-radius:8px; overflow:hidden;\">\n        <tr>\n          <td class=\"t-label\">Sub Total</td>\n          <td class=\"t-value\">{{ frappe.format(doc.net_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n\n        {% if doc.get('discount_amount') %}\n        <tr class=\"discount-row\">\n          <td class=\"t-label\">\n            Discount\n            {% if doc.get('additional_discount_percentage') %}({{ doc.additional_discount_percentage }}%){% endif %}\n          </td>\n          <td class=\"t-value\">\u2212 {{ frappe.format(doc.discount_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n        {% endif %}\n\n        {% for tax in doc.taxes %}\n        <tr>\n          <td class=\"t-label\">{{ tax.description }}{% if tax.rate %} ({{ tax.rate }}%){% endif %}</td>\n          <td class=\"t-value\">{{ frappe.format(tax.tax_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n        {% endfor %}\n\n        {% if doc.get('rounding_adjustment') and doc.rounding_adjustment != 0 %}\n        <tr>\n          <td class=\"t-label\">Rounding</td>\n          <td class=\"t-value\">{{ frappe.format(doc.rounding_adjustment, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n        {% endif %}\n\n        <tr class=\"totals-grand\">\n          <td class=\"t-label\">Total Due</td>\n          <td class=\"t-value\">{{ frappe.format(doc.grand_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n        </tr>\n      </table>\n\n      {% if doc.get('outstanding_amount') and doc.outstanding_amount != doc.grand_total %}\n      <div style=\"margin-top:10px; padding:8px 12px; background:#fff8e1; border-radius:6px; border:1px solid #ffe082; font-size:12px;\">\n        <span style=\"color:#7a5a00; font-weight:600;\">Outstanding Amount:&nbsp;</span>\n        <span style=\"color:#b85000; font-weight:700;\">\n          {{ frappe.format(doc.outstanding_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}\n        </span>\n      </div>\n      {% endif %}\n\n    </div>\n\n  </div>\n  <!-- END FOOTER ROW -->\n\n  <!-- \u2500\u2500 AMOUNT IN WORDS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  {% if doc.in_words %}\n  <div class=\"inv-in-words\">\n    <div class=\"in-words-label\">Amount in Words</div>\n    <div class=\"in-words-text\">{{ doc.in_words }}</div>\n  </div>\n  {% endif %}\n\n  <!-- \u2500\u2500 BANK / PAYMENT DETAILS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-payment\">\n\n    <div class=\"payment-section\">\n      <div class=\"payment-title\">Bank Details</div>\n      {% if doc.get('company_bank_account') %}\n        <div class=\"payment-row\"><span class=\"pk\">Bank</span><span class=\"pv\">{{ doc.company_bank_account }}</span></div>\n      {% endif %}\n      {% if doc.get('bank_account_no') %}\n        <div class=\"payment-row\"><span class=\"pk\">Account No.</span><span class=\"pv\">{{ doc.bank_account_no }}</span></div>\n      {% endif %}\n      {% if doc.get('bank_ifsc') %}\n        <div class=\"payment-row\"><span class=\"pk\">IFSC Code</span><span class=\"pv\">{{ doc.bank_ifsc }}</span></div>\n      {% endif %}\n      <div class=\"payment-row\"><span class=\"pk\">Reference</span><span class=\"pv\">{{ doc.name }}</span></div>\n    </div>\n\n    <div class=\"payment-section\" style=\"border-left:1px solid #edf0f5; padding-left:24px;\">\n      <div class=\"payment-title\">Invoice Summary</div>\n      <div class=\"payment-row\">\n        <span class=\"pk\">Invoice No.</span>\n        <span class=\"pv\">{{ doc.name }}</span>\n      </div>\n      <div class=\"payment-row\">\n        <span class=\"pk\">Invoice Date</span>\n        <span class=\"pv\">{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</span>\n      </div>\n      <div class=\"payment-row\">\n        <span class=\"pk\">Due Date</span>\n        <span class=\"pv\">{{ frappe.format(doc.due_date, {'fieldtype': 'Date'}) if doc.due_date else '\u2014' }}</span>\n      </div>\n      <div class=\"payment-row\" style=\"margin-top:4px; padding-top:8px; border-top:1px solid #edf0f5;\">\n        <span class=\"pk\" style=\"font-weight:700;color:#0d1b3e;\">Amount Due</span>\n        <span class=\"pv\" style=\"color:#0d1b3e; font-size:14px;\">\n          {{ frappe.format(doc.grand_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }}\n        </span>\n      </div>\n    </div>\n\n  </div>\n  <!-- END PAYMENT DETAILS -->\n\n  <!-- \u2500\u2500 SIGNATURE ROW \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-signature\">\n    <div class=\"sig-block\">\n      <div class=\"sig-line\"></div>\n      <div class=\"sig-label\">Authorised Signatory</div>\n      <div style=\"font-size:11.5px; color:#0d1b3e; font-weight:600; margin-top:3px;\">{{ doc.company }}</div>\n    </div>\n    <div style=\"text-align:center;\">\n      <div style=\"font-size:10px; color:#aab0be; font-style:italic;\">\n        This is a computer-generated invoice and does not require a physical signature.\n      </div>\n    </div>\n    <div class=\"sig-block\">\n      <div class=\"sig-line\"></div>\n      <div class=\"sig-label\">Customer Acknowledgement</div>\n    </div>\n  </div>\n\n  <!-- \u2500\u2500 BOTTOM FOOTER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <div class=\"inv-bottom\">\n    <div class=\"bottom-tagline\">Thank you for your business.</div>\n    <div class=\"bottom-doc-ref\">\n      Generated via ERPNext &nbsp;\u00b7&nbsp; Ref: <strong>{{ doc.name }}</strong>\n    </div>\n  </div>\n  <!-- END BOTTOM FOOTER -->\n\n</div>\n<!-- END INV-WRAPPER -->",
