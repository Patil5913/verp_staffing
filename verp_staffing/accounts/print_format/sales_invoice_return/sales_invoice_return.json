{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-04-28 15:03:00.368936",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!-- ============================================================\n     ERPNext \u2014 Credit Note Print Format\n     Theme    : Minimal White + #00AEF7 Blue Accent\n     Doctype  : Sales Invoice (Return)\n     ============================================================ -->\n\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody, .print-format {\n  font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;\n  font-size: 12px;\n  color: #222;\n  background: #fff;\n  line-height: 1.5;\n}\n\n.cn-wrap {\n  width: 100%;\n  max-width: 860px;\n  margin: 0 auto;\n  background: #fff;\n}\n\n/* \u2500\u2500 WATERMARK \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-watermark {\n  position: fixed;\n  top: 38%;\n  left: 50%;\n  transform: translate(-50%, -50%) rotate(-38deg);\n  font-size: 82px;\n  font-weight: 900;\n  letter-spacing: 6px;\n  color: rgba(0, 174, 247, 0.05);\n  text-transform: uppercase;\n  pointer-events: none;\n  white-space: nowrap;\n  z-index: 0;\n}\n\n/* \u2500\u2500 HEADER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-header-table {\n  width: 100%;\n  border-collapse: collapse;\n  border-bottom: 3px solid #00AEF7;\n}\n\n.cn-header-inner {\n  padding: 24px 0 20px;\n  vertical-align: top;\n}\n\n.cn-company-name {\n  font-size: 19px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 4px;\n}\n\n.cn-company-meta {\n  font-size: 10.5px;\n  color: #666;\n  line-height: 1.75;\n}\n\n.cn-title-cell {\n  text-align: right;\n  padding: 24px 0 20px;\n  vertical-align: top;\n}\n\n.cn-doc-label {\n  font-size: 24px;\n  font-weight: 900;\n  color: #111;\n  letter-spacing: 0.5px;\n  line-height: 1;\n  margin-bottom: 3px;\n}\n\n.cn-doc-sub {\n  font-size: 9px;\n  font-weight: 700;\n  color: #00AEF7;\n  letter-spacing: 2.5px;\n  text-transform: uppercase;\n  margin-bottom: 10px;\n}\n\n.cn-doc-number {\n  font-size: 11px;\n  color: #888;\n  margin-bottom: 3px;\n}\n\n.cn-doc-number strong { color: #111; font-size: 12px; }\n\n.cn-ref-badge {\n  display: inline-block;\n  margin-top: 8px;\n  background: #f0faff;\n  border: 1px solid #b3e0fd;\n  padding: 4px 10px;\n  font-size: 10.5px;\n  color: #555;\n  border-radius: 3px;\n}\n\n.cn-ref-badge strong { color: #00AEF7; }\n\n/* \u2500\u2500 INFO STRIP \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-strip-table {\n  width: 100%;\n  border-collapse: collapse;\n  background: #f0faff;\n  border-top: 1px solid #b3e0fd;\n  border-bottom: 1px solid #b3e0fd;\n}\n\n.cn-strip-table td {\n  padding: 6px 0;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  color: #888;\n  white-space: nowrap;\n}\n\n.cn-strip-table td span {\n  font-weight: 600;\n  text-transform: none;\n  margin-left: 4px;\n  letter-spacing: 0;\n  color: #222;\n}\n\n.cn-strip-divider {\n  color: #b3e0fd !important;\n  font-size: 13px !important;\n  font-weight: 300 !important;\n  padding: 6px 6px !important;\n}\n\n/* \u2500\u2500 ALERT BANNER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-alert-table {\n  width: 100%;\n  border-collapse: collapse;\n  background: #f0faff;\n  border-left: 3px solid #00AEF7;\n  margin-top: 14px;\n}\n\n.cn-alert-table td {\n  padding: 10px 14px;\n  font-size: 11px;\n  color: #444;\n  line-height: 1.65;\n}\n\n.cn-alert-strong {\n  font-weight: 700;\n  color: #00AEF7;\n  margin-right: 4px;\n}\n\n/* \u2500\u2500 META SECTION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-meta-outer {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.cn-meta-outer > tbody > tr > td {\n  padding: 16px 0 14px;\n  vertical-align: top;\n  border-right: 1px solid #f0f0f0;\n}\n\n.cn-meta-outer > tbody > tr > td:last-child { border-right: none; }\n.cn-meta-outer > tbody > tr > td + td { padding-left: 16px; }\n\n.cn-section-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.2px;\n  color: #00AEF7;\n  padding-bottom: 5px;\n  border-bottom: 1.5px solid #00AEF7;\n  margin-bottom: 9px;\n  display: block;\n}\n\n.cn-meta-name {\n  font-size: 13px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 3px;\n}\n\n.cn-meta-body {\n  font-size: 11px;\n  color: #444;\n  line-height: 1.7;\n}\n\n.cn-meta-muted { font-size: 10.5px; color: #888; }\n\n.cn-detail-table { width: 100%; border-collapse: collapse; }\n\n.cn-detail-table tr td {\n  padding: 4px 0;\n  font-size: 11px;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.cn-detail-table tr:last-child td { border-bottom: none; }\n.cn-detail-table .dk { color: #888; width: 52%; }\n.cn-detail-table .dv { color: #222; font-weight: 600; text-align: right; }\n.cn-detail-table .dv-accent { color: #00AEF7; font-weight: 700; text-align: right; }\n\n/* \u2500\u2500 DIVIDER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-divider { border: none; border-top: 1px solid #eee; margin: 14px 0 0; }\n\n/* \u2500\u2500 ITEMS TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-items-table {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 14px;\n}\n\n.cn-items-table thead tr { background: #f0faff; }\n\n.cn-items-table thead th {\n  padding: 8px 10px;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: #444;\n  text-align: left;\n  border-top: 2px solid #00AEF7;\n  border-bottom: 1px solid #cde9fd;\n  border-right: 1px solid #ddf0fd;\n  white-space: nowrap;\n}\n\n.cn-items-table thead th:last-child { border-right: none; }\n.cn-items-table thead th.r { text-align: right; }\n\n.cn-items-table tbody tr { border-bottom: 1px solid #f2f2f2; }\n.cn-items-table tbody tr:nth-child(even) { background: #fafeff; }\n.cn-items-table tbody tr:last-child { border-bottom: 2px solid #cde9fd; }\n\n.cn-items-table tbody td {\n  padding: 9px 10px;\n  font-size: 11.5px;\n  color: #333;\n  vertical-align: top;\n  border-right: 1px solid #f2f2f2;\n}\n\n.cn-items-table tbody td:last-child { border-right: none; }\n.cn-items-table tbody td.r { text-align: right; font-variant-numeric: tabular-nums; }\n\n.cn-sno {\n  display: inline-block;\n  width: 20px;\n  height: 20px;\n  line-height: 20px;\n  text-align: center;\n  background: #e8f5fe;\n  border-radius: 2px;\n  font-size: 10px;\n  font-weight: 700;\n  color: #00AEF7;\n}\n\n.cn-item-name { font-weight: 600; color: #111; margin-bottom: 2px; }\n.cn-item-desc { font-size: 10px; color: #999; line-height: 1.4; }\n.cn-neg { color: #e06c00; font-weight: 700; }\n\n/* \u2500\u2500 TAX TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-tax-section { margin-top: 14px; }\n\n.cn-tax-table { width: 100%; border-collapse: collapse; border: 1px solid #eee; }\n\n.cn-tax-table thead th {\n  background: #f0faff;\n  color: #555;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  padding: 7px 10px;\n  text-align: left;\n  border-bottom: 1px solid #cde9fd;\n  border-right: 1px solid #eee;\n}\n\n.cn-tax-table thead th:last-child { border-right: none; }\n.cn-tax-table thead th.r { text-align: right; }\n\n.cn-tax-table tbody td {\n  padding: 7px 10px;\n  font-size: 11px;\n  color: #333;\n  border-bottom: 1px solid #f5f5f5;\n  border-right: 1px solid #f5f5f5;\n}\n\n.cn-tax-table tbody td:last-child { border-right: none; }\n.cn-tax-table tbody tr:last-child td { border-bottom: none; }\n.cn-tax-table tbody td.r { text-align: right; font-weight: 600; }\n\n/* \u2500\u2500 TOTALS + NOTES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-bottom-outer { width: 100%; border-collapse: collapse; margin-top: 14px; }\n\n.cn-bottom-outer > tbody > tr > td {\n  padding: 0;\n  vertical-align: top;\n}\n\n.cn-notes-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: #00AEF7;\n  padding-bottom: 5px;\n  border-bottom: 1.5px solid #00AEF7;\n  margin-bottom: 8px;\n  display: block;\n}\n\n.cn-notes-text { font-size: 11px; color: #666; line-height: 1.65; }\n\n.cn-totals-table { width: 100%; border-collapse: collapse; border: 1px solid #e8e8e8; }\n\n.cn-totals-table tbody tr td {\n  padding: 7px 12px;\n  font-size: 11.5px;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.cn-totals-table tbody tr:last-child td { border-bottom: none; }\n.cn-totals-table .tl { color: #666; }\n.cn-totals-table .tv { text-align: right; color: #222; font-weight: 600; font-variant-numeric: tabular-nums; }\n.cn-totals-table .tv-neg { text-align: right; color: #e06c00; font-weight: 700; }\n\n.cn-grand-row { background: #00AEF7 !important; }\n\n.cn-grand-row td {\n  padding: 11px 14px !important;\n  border-bottom: none !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  color: #fff !important;\n}\n\n.cn-grand-row .tv-grand {\n  text-align: right;\n  color: #fff !important;\n  font-size: 16px !important;\n  font-weight: 800 !important;\n}\n\n.cn-credit-notice {\n  margin-top: 8px;\n  padding: 8px 12px;\n  background: #f0faff;\n  border: 1px solid #b3e0fd;\n  border-left: 3px solid #00AEF7;\n  font-size: 11px;\n  color: #333;\n}\n\n/* \u2500\u2500 AMOUNT IN WORDS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-words-box {\n  background: #f0faff;\n  border-left: 3px solid #00AEF7;\n  padding: 9px 14px;\n  margin-top: 14px;\n}\n\n.cn-words-label {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: #00AEF7;\n  margin-bottom: 3px;\n}\n\n.cn-words-text { font-size: 11.5px; color: #111; font-style: italic; font-weight: 500; }\n\n/* \u2500\u2500 PAYMENT / SUMMARY BOX \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-payment-outer { width: 100%; border-collapse: collapse; margin-top: 14px; }\n.cn-payment-outer > tbody > tr > td { padding: 0; }\n\n.cn-payment-box { width: 100%; border-collapse: collapse; border: 1px solid #e8e8e8; border-top: 2px solid #00AEF7; }\n\n.cn-payment-box > tbody > tr > td {\n  padding: 14px 16px;\n  vertical-align: top;\n  width: 50%;\n}\n\n.cn-payment-box > tbody > tr > td + td { border-left: 1px solid #f0f0f0; }\n\n.cn-pay-title {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: #00AEF7;\n  padding-bottom: 6px;\n  border-bottom: 1px solid #e8e8e8;\n  margin-bottom: 10px;\n  display: block;\n}\n\n.cn-pay-table { width: 100%; border-collapse: collapse; }\n\n.cn-pay-table tr td { padding: 4px 0; font-size: 11px; border-bottom: 1px solid #f8f8f8; }\n.cn-pay-table tr:last-child td { border-bottom: none; }\n.cn-pay-table .pk { color: #888; }\n.cn-pay-table .pv { text-align: right; color: #222; font-weight: 600; }\n\n.cn-pay-total-row td { border-top: 1.5px solid #e8e8e8 !important; padding-top: 8px !important; }\n.cn-pay-total-row .pk { font-weight: 700; color: #111 !important; }\n.cn-pay-total-row .pv { color: #00AEF7 !important; font-size: 13px !important; }\n\n/* \u2500\u2500 SIGNATURE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-sig-outer { width: 100%; border-collapse: collapse; margin-top: 22px; }\n\n.cn-sig-outer > tbody > tr > td {\n  padding: 0;\n  text-align: center;\n  vertical-align: bottom;\n}\n\n.cn-sig-line {\n  border-top: 1.5px solid #00AEF7;\n  width: 160px;\n  margin: 0 auto 6px;\n}\n\n.cn-sig-label {\n  font-size: 9.5px;\n  color: #888;\n  text-transform: uppercase;\n  letter-spacing: 0.8px;\n  font-weight: 600;\n}\n\n.cn-sig-note { font-size: 10px; color: #bbb; font-style: italic; text-align: center; }\n\n/* \u2500\u2500 FOOTER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.cn-footer-table {\n  width: 100%;\n  border-collapse: collapse;\n  border-top: 2px solid #00AEF7;\n  margin-top: 22px;\n}\n\n.cn-footer-table td { padding: 10px 0; font-size: 9.5px; }\n.cn-footer-left { color: #aaa; font-style: italic; }\n.cn-footer-right { text-align: right; color: #888; }\n.cn-footer-right strong { color: #00AEF7; }\n\n/* \u2500\u2500 UTILITY \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.muted { color: #aaa; }\n.fw6   { font-weight: 600; }\n.fw7   { font-weight: 700; }\n.ta-r  { text-align: right; }\n\n@media print {\n  body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n  .cn-wrap { max-width: 100%; }\n  .cn-watermark { position: fixed; }\n}\n</style>\n\n<div class=\"cn-watermark\">Credit Note</div>\n\n<div class=\"cn-wrap\">\n\n<!-- 1. HEADER -->\n<table class=\"cn-header-table\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td class=\"cn-header-inner\" style=\"vertical-align:top; width:55%;\">\n        {% if doc.get('company_logo') %}\n          <img src=\"{{ doc.company_logo }}\" alt=\"{{ doc.company }}\"\n               style=\"max-height:42px; margin-bottom:8px; display:block;\">\n        {% endif %}\n        <div class=\"cn-company-name\">{{ doc.company }}</div>\n        <div class=\"cn-company-meta\">\n          {% if doc.get('company_address') %}{{ doc.company_address | replace('\\n', '<br>') }}<br>{% endif %}\n          {% if doc.get('company_gstin') %}GSTIN: {{ doc.company_gstin }}{% endif %}\n          {% if doc.get('company_pan') %}&nbsp;&nbsp;|&nbsp;&nbsp;PAN: {{ doc.company_pan }}{% endif %}\n        </div>\n      </td>\n      <td class=\"cn-title-cell\" style=\"width:45%;\">\n        <div class=\"cn-doc-sub\">Sales Return</div>\n        <div class=\"cn-doc-label\">Credit Note</div>\n        <div class=\"cn-doc-number\" style=\"margin-top:8px;\">Document No.&nbsp;<strong>{{ doc.name }}</strong></div>\n        <div class=\"cn-doc-number\" style=\"margin-top:2px;\">Date:&nbsp;<strong>{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</strong></div>\n        {% if doc.get('return_against') %}\n        <div style=\"margin-top:6px;\">\n          <span class=\"cn-ref-badge\">Against Invoice:&nbsp;<strong>{{ doc.return_against }}</strong></span>\n        </div>\n        {% endif %}\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 2. INFO STRIP -->\n<table class=\"cn-strip-table\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td>Credit Note Date <span>{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</span></td>\n      <td class=\"cn-strip-divider\">|</td>\n      <td>Original Invoice <span>{{ doc.get('return_against') or '\u2014' }}</span></td>\n      {% if doc.get('due_date') %}\n      <td class=\"cn-strip-divider\">|</td>\n      <td>Due Date <span>{{ frappe.format(doc.due_date, {'fieldtype': 'Date'}) }}</span></td>\n      {% endif %}\n      <td class=\"cn-strip-divider\">|</td>\n      <td>Currency <span>{{ doc.currency }}</span></td>\n      <td style=\"text-align:right;\">\n        <span style=\"background:#00AEF7; color:#fff; padding:3px 10px; font-size:9px; font-weight:800; letter-spacing:1px; text-transform:uppercase;\">\n          &#8617;&nbsp;Return\n        </span>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 3. ALERT BANNER -->\n<table class=\"cn-alert-table\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td>\n        <span class=\"cn-alert-strong\">&#9432; This is a Credit Note.</span>\n        This document records the return of goods/services\n        {% if doc.get('return_against') %}originally invoiced under <strong>{{ doc.return_against }}</strong>.\n        {% else %}and creates a credit balance in the customer's account.{% endif %}\n        The amounts represent values being <strong>credited back</strong> to the customer.\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 4. META -->\n<table class=\"cn-meta-outer\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"width:36%;\">\n        <span class=\"cn-section-label\">Bill To</span>\n        <div class=\"cn-meta-name\">{{ doc.customer }}</div>\n        <div class=\"cn-meta-body\">\n          {% if doc.get('customer_address') %}{{ doc.customer_address | replace('\\n', '<br>') }}{% endif %}\n          {% if doc.get('contact_display') %}<br><span class=\"cn-meta-muted\">Attn: {{ doc.contact_display }}</span>{% endif %}\n          {% if doc.get('contact_email') %}<br><span class=\"cn-meta-muted\">{{ doc.contact_email }}</span>{% endif %}\n          {% if doc.get('customer_gstin') %}<br><span class=\"cn-meta-muted\">GSTIN: {{ doc.customer_gstin }}</span>{% endif %}\n        </div>\n      </td>\n      <td style=\"width:32%; padding-left:16px;\">\n        <span class=\"cn-section-label\">Return Reference</span>\n        <table class=\"cn-detail-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            <tr><td class=\"dk\">Credit Note No.</td><td class=\"dv-accent\">{{ doc.name }}</td></tr>\n            <tr><td class=\"dk\">Credit Note Date</td><td class=\"dv\">{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</td></tr>\n            {% if doc.get('return_against') %}<tr><td class=\"dk\">Original Invoice</td><td class=\"dv-accent\">{{ doc.return_against }}</td></tr>{% endif %}\n            {% if doc.get('place_of_supply') %}<tr><td class=\"dk\">Place of Supply</td><td class=\"dv\">{{ doc.place_of_supply }}</td></tr>{% endif %}\n            {% if doc.get('cost_center') %}<tr><td class=\"dk\">Cost Centre</td><td class=\"dv\">{{ doc.cost_center }}</td></tr>{% endif %}\n          </tbody>\n        </table>\n      </td>\n      <td style=\"width:32%; padding-left:16px;\">\n        <span class=\"cn-section-label\">Return Details</span>\n        <table class=\"cn-detail-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            {% if doc.get('remarks') %}<tr><td class=\"dk\">Reason</td><td class=\"dv\">{{ doc.remarks }}</td></tr>{% endif %}\n            {% if doc.get('territory') %}<tr><td class=\"dk\">Territory</td><td class=\"dv\">{{ doc.territory }}</td></tr>{% endif %}\n            {% if doc.get('payment_terms_template') %}<tr><td class=\"dk\">Payment Terms</td><td class=\"dv\">{{ doc.payment_terms_template }}</td></tr>{% endif %}\n            <tr>\n              <td class=\"dk\">Status</td>\n              <td class=\"dv\">\n                <span style=\"background:#e6f6ff; color:#00AEF7; padding:2px 8px; border:1px solid #b3e0fd; font-size:9.5px; font-weight:700; border-radius:2px; white-space:nowrap;\">\n                  Credit Issued\n                </span>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<hr class=\"cn-divider\">\n\n<!-- 5. ITEMS TABLE -->\n<table class=\"cn-items-table\" cellpadding=\"0\" cellspacing=\"0\">\n  <thead>\n    <tr>\n      <th style=\"width:34px;\">#</th>\n      <th>Item &amp; Description</th>\n      <th class=\"r\" style=\"width:80px;\">HSN / SAC</th>\n      <th class=\"r\" style=\"width:72px;\">Ret. Qty</th>\n      <th class=\"r\" style=\"width:48px;\">UOM</th>\n      <th class=\"r\" style=\"width:96px;\">Rate ({{ doc.currency }})</th>\n      {% if doc.get('discount_amount') or doc.get('additional_discount_percentage') %}\n      <th class=\"r\" style=\"width:72px;\">Disc.</th>\n      {% endif %}\n      <th class=\"r\" style=\"width:104px;\">Amount ({{ doc.currency }})</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for item in doc.items %}\n    {%- set iqty = item.qty -%}\n    <tr>\n      <td><span class=\"cn-sno\">{{ loop.index }}</span></td>\n      <td>\n        <div class=\"cn-item-name\">{{ item.item_name or item.item_code }}</div>\n        {% if item.get('description') and item.description != item.item_name %}\n          <div class=\"cn-item-desc\">{{ item.description | striptags | truncate(160) }}</div>\n        {% endif %}\n        {% if item.get('item_code') and item.item_code != item.item_name %}\n          <div class=\"cn-item-desc\" style=\"margin-top:1px;\">Code: {{ item.item_code }}</div>\n        {% endif %}\n      </td>\n      <td class=\"r\" style=\"color:#aaa;\">{{ item.get('gst_hsn_code') or '\u2014' }}</td>\n      <td class=\"r cn-neg\">\n        {% if iqty < 0 %}({{ (iqty * -1) | int if (iqty * -1) == (iqty * -1) | int else (iqty * -1) }})\n        {% else %}{{ iqty | int if iqty == iqty | int else iqty }}{% endif %}\n      </td>\n      <td class=\"r\" style=\"color:#aaa;\">{{ item.uom }}</td>\n      <td class=\"r\">{{ frappe.format(item.rate, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n      {% if doc.get('discount_amount') or doc.get('additional_discount_percentage') %}\n      <td class=\"r\" style=\"color:#e06c00;\">{% if item.get('discount_percentage') %}{{ item.discount_percentage }}%{% else %}\u2014{% endif %}</td>\n      {% endif %}\n      <td class=\"r cn-neg\">\n        ({{ frappe.format((item.amount * -1) if item.amount < 0 else item.amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }})\n      </td>\n    </tr>\n    {% endfor %}\n  </tbody>\n</table>\n\n<!-- 6. TAX BREAKDOWN -->\n{% if doc.taxes %}\n<div class=\"cn-tax-section\">\n  <span class=\"cn-section-label\" style=\"display:block; margin-bottom:8px;\">Tax Breakdown (Reversed)</span>\n  <table class=\"cn-tax-table\" cellpadding=\"0\" cellspacing=\"0\">\n    <thead>\n      <tr>\n        <th>Tax / Charge</th>\n        <th>Account Head</th>\n        <th class=\"r\">Rate</th>\n        <th class=\"r\">Amount ({{ doc.currency }})</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for tax in doc.taxes %}\n      <tr>\n        <td>{{ tax.description }}</td>\n        <td style=\"color:#aaa;\">{{ tax.account_head }}</td>\n        <td class=\"r\">{{ tax.rate }}%</td>\n        <td class=\"r cn-neg\">({{ frappe.format(tax.tax_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }})</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n</div>\n{% endif %}\n\n<!-- 7. NOTES + TOTALS -->\n<table class=\"cn-bottom-outer\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"width:47%; padding-right:16px;\">\n        {% if doc.get('terms') %}\n        <span class=\"cn-notes-label\">Terms &amp; Conditions</span>\n        <div class=\"cn-notes-text\">{{ doc.terms | striptags }}</div>\n        {% endif %}\n        {% if doc.get('remarks') %}\n        <span class=\"cn-notes-label\" style=\"display:block; margin-top:12px;\">Return Reason</span>\n        <div class=\"cn-notes-text\">{{ doc.remarks }}</div>\n        {% endif %}\n        <span class=\"cn-notes-label\" style=\"display:block; margin-top:12px;\">How This Credit Works</span>\n        <div class=\"cn-notes-text\">\n          This credit note reduces the outstanding balance on your account.\n          The credited amount can be applied against future invoices or\n          refunded per your agreement with {{ doc.company }}.\n        </div>\n      </td>\n      <td style=\"width:6%;\"></td>\n      <td style=\"width:47%;\">\n        <table class=\"cn-totals-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            <tr>\n              <td class=\"tl\">Return Sub-Total</td>\n              <td class=\"tv-neg\">({{ frappe.format(doc.net_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }})</td>\n            </tr>\n            {% if doc.get('discount_amount') %}\n            <tr>\n              <td class=\"tl\">Discount{% if doc.get('additional_discount_percentage') %} ({{ doc.additional_discount_percentage }}%){% endif %}</td>\n              <td class=\"tv\">{{ frappe.format(doc.discount_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n            {% endif %}\n            {% for tax in doc.taxes %}\n            <tr>\n              <td class=\"tl\">{{ tax.description }}{% if tax.rate %} ({{ tax.rate }}%){% endif %}</td>\n              <td class=\"tv-neg\">({{ frappe.format(tax.tax_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }})</td>\n            </tr>\n            {% endfor %}\n            {% if doc.get('rounding_adjustment') and doc.rounding_adjustment != 0 %}\n            <tr>\n              <td class=\"tl\">Rounding</td>\n              <td class=\"tv\">{{ frappe.format(doc.rounding_adjustment, {'fieldtype': 'Currency', 'currency': doc.currency}) }}</td>\n            </tr>\n            {% endif %}\n            <tr class=\"cn-grand-row\">\n              <td>Total Credit</td>\n              <td class=\"tv-grand\">({{ frappe.format(doc.grand_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }})</td>\n            </tr>\n          </tbody>\n        </table>\n        {% if doc.get('outstanding_amount') %}\n        <div class=\"cn-credit-notice\">\n          <strong>Net Credit Balance:&nbsp;</strong>\n          {{ frappe.format(doc.outstanding_amount, {'fieldtype': 'Currency', 'currency': doc.currency}) }}\n          &nbsp;available for future settlement.\n        </div>\n        {% endif %}\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 8. AMOUNT IN WORDS -->\n{% if doc.get('in_words') %}\n<div class=\"cn-words-box\">\n  <div class=\"cn-words-label\">Credit Amount in Words</div>\n  <div class=\"cn-words-text\">{{ doc.in_words }}</div>\n</div>\n{% endif %}\n\n<!-- 9. PAYMENT / SUMMARY BOX -->\n<table class=\"cn-payment-outer\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td>\n        <table class=\"cn-payment-box\" cellpadding=\"0\" cellspacing=\"0\">\n          <tbody>\n            <tr>\n              <td>\n                <span class=\"cn-pay-title\">Bank Details</span>\n                <table class=\"cn-pay-table\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tbody>\n                    {% if doc.get('company_bank_account') %}<tr><td class=\"pk\">Bank</td><td class=\"pv\">{{ doc.company_bank_account }}</td></tr>{% endif %}\n                    {% if doc.get('bank_account_no') %}<tr><td class=\"pk\">Account No.</td><td class=\"pv\">{{ doc.bank_account_no }}</td></tr>{% endif %}\n                    {% if doc.get('bank_ifsc') %}<tr><td class=\"pk\">IFSC Code</td><td class=\"pv\">{{ doc.bank_ifsc }}</td></tr>{% endif %}\n                    <tr><td class=\"pk\">Reference</td><td class=\"pv\">{{ doc.name }}</td></tr>\n                  </tbody>\n                </table>\n              </td>\n              <td>\n                <span class=\"cn-pay-title\">Credit Note Summary</span>\n                <table class=\"cn-pay-table\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tbody>\n                    <tr><td class=\"pk\">Credit Note No.</td><td class=\"pv\">{{ doc.name }}</td></tr>\n                    {% if doc.get('return_against') %}<tr><td class=\"pk\">Against Invoice</td><td class=\"pv\">{{ doc.return_against }}</td></tr>{% endif %}\n                    <tr><td class=\"pk\">Issue Date</td><td class=\"pv\">{{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</td></tr>\n                    <tr class=\"cn-pay-total-row\">\n                      <td class=\"pk\">Total Credit</td>\n                      <td class=\"pv\">({{ frappe.format(doc.grand_total, {'fieldtype': 'Currency', 'currency': doc.currency}) }})</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 10. SIGNATURE -->\n<table class=\"cn-sig-outer\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"width:33%;\">\n        <div class=\"cn-sig-line\"></div>\n        <div class=\"cn-sig-label\">Authorised Signatory</div>\n        <div style=\"font-size:11px; color:#111; font-weight:600; margin-top:3px;\">{{ doc.company }}</div>\n      </td>\n      <td style=\"width:34%; vertical-align:middle;\">\n        <div class=\"cn-sig-note\">\n          This is a computer-generated credit note<br>and does not require a physical signature.\n        </div>\n      </td>\n      <td style=\"width:33%;\">\n        <div class=\"cn-sig-line\"></div>\n        <div class=\"cn-sig-label\">Customer Acknowledgement</div>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<!-- 11. FOOTER -->\n<table class=\"cn-footer-table\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td class=\"cn-footer-left\">Credit Note issued by {{ doc.company }} \u2014 Thank you for your business.</td>\n      <td class=\"cn-footer-right\">Generated via ERPNext &nbsp;\u00b7&nbsp; Ref:&nbsp;<strong>{{ doc.name }}</strong></td>\n    </tr>\n  </tbody>\n</table>\n\n</div>",
